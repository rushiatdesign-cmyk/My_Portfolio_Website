---
import '../styles/home-hero.css';
import buildingsGround from '../../Images/buildings_ground.png';
import building1Top from '../../Images/building_1_top.png';
import building2Top from '../../Images/building_2_top.png';
import building3Top from '../../Images/building_3_top.png';
import building4Top from '../../Images/building_4_top.png';
import building5Top from '../../Images/building_5_top.png';
import building6Top from '../../Images/building_6_top.png';

const layers = [
	{ src: building1Top.src, alt: 'Building 1' },
	{ src: building2Top.src, alt: 'Building 2' },
	{ src: building3Top.src, alt: 'Building 3' },
	{ src: building4Top.src, alt: 'Building 4' },
	{ src: building5Top.src, alt: 'Building 5' },
	{ src: building6Top.src, alt: 'Building 6' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Hero</title>
	</head>
	<body>
		<main id="hero" class="hero">
			<div id="hero-scene" class="scene">

    <div id="hero-camera" class="camera">

        <div id="hero-scene-track" class="scene__track">

            <img id="hero-ground"
                class="scene__ground"
                src={buildingsGround.src}
                alt="Ground background" />

            <img id="building-1" class="scene__layer" src={building1Top.src} />
            <img id="building-2" class="scene__layer" src={building2Top.src} />
            <img id="building-3" class="scene__layer" src={building3Top.src} />
            <img id="building-4" class="scene__layer" src={building4Top.src} />
            <img id="building-5" class="scene__layer" src={building5Top.src} />
            <img id="building-6" class="scene__layer" src={building6Top.src} />


			
<!-- Keep ALL hotspots exactly here -->

			<button class="hotspot" type="button" data-target="building-1" data-left="6" data-top="50" data-width="14" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-2" data-left="20" data-top="50" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-3" data-left="34" data-top="49" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-4" data-left="46" data-top="49" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-5" data-left="58" data-top="52" data-width="11" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-6" data-left="68" data-top="52" data-width="16" data-height="24"></button>

				<!-- Keep ALL buttons exactly here -->

			<a class="shop-btn shop-btn-1" href="/bakery">Bakery</a>
			<a class="shop-btn shop-btn-2" href="/books">Books</a>
			<a class="shop-btn shop-btn-3" href="/clothing">Clothing</a>
			<a class="shop-btn shop-btn-4" href="/cafe">Cafe</a>
			<a class="shop-btn shop-btn-5" href="/fruits">Fruits</a>
			<a class="shop-btn shop-btn-6" href="/electronics">Electronics</a>
        </div>
		
		

    </div>

    

</div>

				
			
		</main>

		<script type="module" src="/src/js/main.js"></script>
	</body>
</html>
