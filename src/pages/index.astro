---
import { Image } from "astro:assets";
import "../styles/home-hero.css";
import buildingsGround from "../../Images/buildings_ground.webp";
import building1Top from "../../Images/building_1_top.webp";
import building2Top from "../../Images/building_2_top.webp";
import building3Top from "../../Images/building_3_top.webp";
import building4Top from "../../Images/building_4_top.webp";
import building5Top from "../../Images/building_5_top.webp";
import building6Top from "../../Images/building_6_top.webp";
import scootyGif from "../../Images/scooty.gif?url";
import cloudsImg from "../../Images/clouds.webp";
import ModalShell from "../components/modals/ModalShell.astro";

// The source art is 6000x4000. By keeping it at 6000 and forcing quality="max",
// we prevent Astro from compressing or downsizing the image, keeping it 
// razor-sharp even at maximum GSAP camera zoom levels.
const HERO_WIDTH = 6000;

const layers = [
	{ id: "building-1", img: building1Top, alt: "Building 1" },
	{ id: "building-2", img: building2Top, alt: "Building 2" },
	{ id: "building-3", img: building3Top, alt: "Building 3" },
	{ id: "building-4", img: building4Top, alt: "Building 4" },
	{ id: "building-5", img: building5Top, alt: "Building 5" },
	{ id: "building-6", img: building6Top, alt: "Building 6" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Hero</title>
	</head>
	<body>
		<ModalShell />

		<main id="hero" class="hero">
			<div id="hero-scene" class="scene">
				<div id="hero-camera" class="camera">
					<div id="hero-scene-track" class="scene__track">
						<div class="scene__clouds">
							<Image
								id="hero-clouds-1"
								class="scene__clouds-img"
								src={cloudsImg}
								width={HERO_WIDTH}
								quality="max"
								alt="Clouds"
								loading="eager"
								fetchpriority="high"
							/>
							<Image
								id="hero-clouds-2"
								class="scene__clouds-img"
								src={cloudsImg}
								width={HERO_WIDTH}
								quality="max"
								alt="Clouds"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
						<Image
							id="hero-ground"
							class="scene__ground"
							src={buildingsGround}
							width={HERO_WIDTH}
							quality="max"
							alt="Ground background"
							loading="eager"
							fetchpriority="high"
						/>

						<img
							id="hero-scooty"
							class="scene__scooty"
							src={scootyGif}
							alt="Scooter"
						/>

						<div class="scene__stage">
							{
								layers.map((layer) => (
									<Image
										id={layer.id}
										class="scene__layer"
										src={layer.img}
										width={HERO_WIDTH}
										quality="max"
										alt={layer.alt}
										loading="eager"
									/>
								))
							}

							<div class="hotspot-layer">
								<div
									class="hotspot"
									data-target="building-1"
									data-shop="building1"
									data-left="6"
									data-top="65"
									data-width="14"
									data-height="18"
								>
									<a
										class="hotspot-trigger"
										href="/blog"
										aria-label="Blog"></a>
								</div>

								<div
									class="hotspot"
									data-target="building-2"
									data-shop="building2"
									data-left="20"
									data-top="65"
									data-width="12"
									data-height="18"
								>
									<a
										class="hotspot-trigger"
										href="/stuff"
										aria-label="Stuff"></a>
								</div>

								<div
									class="hotspot"
									data-target="building-3"
									data-shop="building3"
									data-left="30"
									data-top="64"
									data-width="16"
									data-height="18"
								>
									<a
										class="hotspot-trigger"
										href="/about"
										aria-label="About"></a>
								</div>

								<div
									class="hotspot"
									data-target="building-4"
									data-shop="building4"
									data-left="46"
									data-top="64"
									data-width="12"
									data-height="18"
								>
									<a
										class="hotspot-trigger"
										href="/learntype"
										aria-label="Learn Type"></a>
								</div>

								<div
									class="hotspot"
									data-target="building-5"
									data-shop="building5"
									data-left="58"
									data-top="67"
									data-width="11"
									data-height="18"
								>
									<a
										class="hotspot-trigger"
										href="/work"
										aria-label="Work"></a>
								</div>

								<div
									class="hotspot"
									data-target="building-6"
									data-shop="building6"
									data-left="68"
									data-top="67"
									data-width="16"
									data-height="18"
								>
									<div class="box-layer">
										<button
											class="box-trigger"
											type="button"
											data-modal="music"
											style="--bx-left: 6%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"
										></button>
										<button
											class="box-trigger"
											type="button"
											data-modal="personal"
											style="--bx-left: 35%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"
										></button>
										<button
											class="box-trigger"
											type="button"
											data-modal="poetry"
											style="--bx-left: 64%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"
										></button>
										<button
											class="box-trigger"
											type="button"
											data-modal="todo"
											style="--bx-left: 6%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"
										></button>
										<button
											class="box-trigger"
											type="button"
											data-modal="photowall"
											style="--bx-left: 35%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"
										></button>
										<button
											class="box-trigger"
											type="button"
											data-modal="dailydose"
											style="--bx-left: 64%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"
										></button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

		<script src="../js/main.js"></script>
	</body>
</html>
