---
import '../styles/home-hero.css';
import buildingsGround from '../../Images/buildings_ground.png';
import building1Top from '../../Images/building_1_top.png';
import building2Top from '../../Images/building_2_top.png';
import building3Top from '../../Images/building_3_top.png';
import building4Top from '../../Images/building_4_top.png';
import building5Top from '../../Images/building_5_top.png';
import building6Top from '../../Images/building_6_top.png';
import ModalShell from '../components/modals/ModalShell.astro';

const layers = [
	{ src: building1Top.src, alt: 'Building 1' },
	{ src: building2Top.src, alt: 'Building 2' },
	{ src: building3Top.src, alt: 'Building 3' },
	{ src: building4Top.src, alt: 'Building 4' },
	{ src: building5Top.src, alt: 'Building 5' },
	{ src: building6Top.src, alt: 'Building 6' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Hero</title>
	</head>
	<body>

		<ModalShell />

		<main id="hero" class="hero">
			<div id="hero-scene" class="scene">

    <div id="hero-camera" class="camera">

        <div id="hero-scene-track" class="scene__track">

            <img id="hero-ground"
                class="scene__ground"
                src={buildingsGround.src}
                alt="Ground background" />

			<div class="scene__stage">
            <img id="building-1" class="scene__layer" src={building1Top.src} />
            <img id="building-2" class="scene__layer" src={building2Top.src} />
            <img id="building-3" class="scene__layer" src={building3Top.src} />
            <img id="building-4" class="scene__layer" src={building4Top.src} />
            <img id="building-5" class="scene__layer" src={building5Top.src} />
            <img id="building-6" class="scene__layer" src={building6Top.src} />

            <div class="hotspot-layer">
                <div class="hotspot" 
				data-target="building-1" 
				data-shop="building1" 
				data-left="6" 
				data-top="50" 
				data-width="14" 
				data-height="24">
				
	<a class="hotspot-trigger" href="/bakery" aria-label="Bakery"></a>
</div>

<div class="hotspot" data-target="building-2" data-shop="building2" data-left="20" data-top="50" data-width="12" data-height="24">
	<a class="hotspot-trigger" href="/bakery" aria-label="Bakery"></a>
</div>

<div class="hotspot" data-target="building-3" data-shop="building3" data-left="34" data-top="49" data-width="12" data-height="24">
	<a class="hotspot-trigger" href="/bakery" aria-label="Bakery"></a>
</div>

<div class="hotspot" data-target="building-4" data-shop="building4" data-left="46" data-top="49" data-width="12" data-height="24">
	<a class="hotspot-trigger" href="/bakery" aria-label="Bakery"></a>
</div>

<div class="hotspot" data-target="building-5" data-shop="building5" data-left="58" data-top="52" data-width="11" data-height="24">
	<a class="hotspot-trigger" href="/bakery" aria-label="Bakery"></a>
</div>

<div class="hotspot" data-target="building-6" data-shop="building6" data-left="68" data-top="52" data-width="16" data-height="24">
	<div class="box-layer">
		<button class="box-trigger" type="button" data-modal="music" style="--bx-left: 6%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"></button>
		<button class="box-trigger" type="button" data-modal="personal" style="--bx-left: 35%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"></button>
		<button class="box-trigger" type="button" data-modal="poetry" style="--bx-left: 64%; --bx-top: 40%; --bx-width: 24%; --bx-height: 20%;"></button>
		<button class="box-trigger" type="button" data-modal="todo" style="--bx-left: 6%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"></button>
		<button class="box-trigger" type="button" data-modal="photowall" style="--bx-left: 35%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"></button>
		<button class="box-trigger" type="button" data-modal="dailydose" style="--bx-left: 64%; --bx-top: 63%; --bx-width: 24%; --bx-height: 20%;"></button>
	</div>
</div>

            </div>

			</div>
        </div>
		
		

    </div>

    

</div>

				
			
		</main>

		<script type="module" src="/src/js/main.js"></script>
	</body>
</html>
