---
import '../styles/home-hero.css';
import buildingsGround from '../../Images/buildings_ground.png';
import building1Top from '../../Images/building_1_top.png';
import building2Top from '../../Images/building_2_top.png';
import building3Top from '../../Images/building_3_top.png';
import building4Top from '../../Images/building_4_top.png';
import building5Top from '../../Images/building_5_top.png';
import building6Top from '../../Images/building_6_top.png';

const layers = [
	{ src: building1Top.src, alt: 'Building 1' },
	{ src: building2Top.src, alt: 'Building 2' },
	{ src: building3Top.src, alt: 'Building 3' },
	{ src: building4Top.src, alt: 'Building 4' },
	{ src: building5Top.src, alt: 'Building 5' },
	{ src: building6Top.src, alt: 'Building 6' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Hero</title>
	</head>
	<body>
		<main class="hero">
			<div class="scene">
				<img class="scene__ground" src={buildingsGround.src} alt="Ground background" />

				<img id="building-1" class="scene__layer" src={building1Top.src} alt="Building 1" aria-hidden="true" />
				<img id="building-2" class="scene__layer" src={building2Top.src} alt="Building 2" aria-hidden="true" />
				<img id="building-3" class="scene__layer" src={building3Top.src} alt="Building 3" aria-hidden="true" />
				<img id="building-4" class="scene__layer" src={building4Top.src} alt="Building 4" aria-hidden="true" />
				<img id="building-5" class="scene__layer" src={building5Top.src} alt="Building 5" aria-hidden="true" />
				<img id="building-6" class="scene__layer" src={building6Top.src} alt="Building 6" aria-hidden="true" />

				<button class="hotspot" type="button" data-target="building-1" data-left="6" data-top="50" data-width="14" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-2" data-left="20" data-top="50" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-3" data-left="34" data-top="49" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-4" data-left="46" data-top="49" data-width="12" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-5" data-left="58" data-top="52" data-width="11" data-height="24"></button>
				<button class="hotspot" type="button" data-target="building-6" data-left="68" data-top="52" data-width="16" data-height="24"></button>
			</div>
		</main>

		<script>
			const hotspots = Array.from(document.querySelectorAll<HTMLButtonElement>('.hotspot'));

			hotspots.forEach((hotspot) => {
				const targetId = hotspot.dataset.target;
				const left = hotspot.dataset.left;
				const top = hotspot.dataset.top;
				const width = hotspot.dataset.width;
				const height = hotspot.dataset.height;

				hotspot.style.setProperty('--left', `${left}%`);
				hotspot.style.setProperty('--top', `${top}%`);
				hotspot.style.setProperty('--width', `${width}%`);
				hotspot.style.setProperty('--height', `${height}%`);

				if (!targetId) return;

				const target = document.getElementById(targetId);
				if (!(target instanceof HTMLImageElement)) return;

				const activate = () => target.classList.add('is-active');
				const deactivate = () => target.classList.remove('is-active');

				hotspot.addEventListener('mouseenter', activate);
				hotspot.addEventListener('mouseleave', deactivate);
				hotspot.addEventListener('focus', activate);
				hotspot.addEventListener('blur', deactivate);
			});
		</script>
	</body>
</html>
