---
/**
 * blog.astro  — illustrated blog listing page
 * Assets from /images/frame/
 */
import { getCollection, render } from 'astro:content';
import { calcReadingTime } from '../components/content/ReadingTime.ts';
import ContentModal from '../components/content/ContentModal.astro';

const rawPosts = await getCollection('blog');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const postsWithHtml = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);

const modalPosts = postsWithHtml.map(({ post }) => ({
  id:          post.id,
  title:       post.data.title,
  description: post.data.description,
  image:       post.data.image,
  publishDate: post.data.publishDate.toISOString(),
  tags:        post.data.tags ?? [],
  views:       post.data.views ?? 0,
  readingTime: calcReadingTime(post.body ?? ''),
  bodyHtml:    null,
}));

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico" />
  <title>Blog — Portfolio</title>
  <meta name="description" content="Essays, notes, and observations on design, process, and making things." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet" />
</head>

<body>

  <!-- Full-viewport hand-drawn border (frame.PNG) -->
  <div class="blog-frame" aria-hidden="true"></div>

  <!-- Fixed decorative elements -->
  <img src="/images/frame/treeleft.PNG"  class="deco deco--treeleft"  alt="" aria-hidden="true" />
  <img src="/images/frame/treeright.PNG" class="deco deco--treeright" alt="" aria-hidden="true" />
  <img src="/images/frame/frameleft.PNG"  class="deco deco--frameleft"  alt="" aria-hidden="true" />
  <img src="/images/frame/frameright.PNG" class="deco deco--frameright" alt="" aria-hidden="true" />
  <img src="/images/frame/lilly.PNG" class="deco deco--lilly" alt="Lilly the dog" />

  <!-- Page content -->
  <main class="blog-page">

    <!-- Blog logo banner — top center -->
    <header class="blog-header">
      <img src="/images/frame/bloglogo.PNG" class="blog-logo" alt="Blog" />
    </header>

    <!-- Card grid -->
    <section class="blog-grid" aria-label="Blog posts">
      {sortedPosts.map((post) => {
        const readTime = calcReadingTime(post.body ?? '');
        const views    = post.data.views ?? 0;
        const date     = fmtDate(post.data.publishDate);
        return (
          <article class="blog-card" data-post-id={post.id}>

            <!-- Maximize icon sits above the border, top-right -->
            <button
              class="blog-card__maximize"
              type="button"
              aria-label={`Read: ${post.data.title}`}
              data-expand-post={post.id}
              data-content-type="blog"
            >
              <img src="/images/frame/maximizeo.PNG" alt="Open post" />
            </button>

            <!-- Hand-drawn card border (blogborder.PNG) -->
            <div class="blog-card__inner">

              <!-- Photo — cut-corner shape via clip-path -->
              <div class="blog-card__img-wrap">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="blog-card__img"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Text below image -->
              <div class="blog-card__body">
                <h2 class="blog-card__title">{post.data.title}</h2>
                <span class="blog-card__divider" aria-hidden="true"></span>
                <div class="blog-card__meta">
                  <span class="blog-card__meta-item">
                    <img src="/images/frame/viewso.PNG"    alt="Views"        class="blog-card__icon" />
                    <span>{views}</span>
                  </span>
                  <span class="blog-card__sep" aria-hidden="true">|</span>
                  <span class="blog-card__meta-item">
                    <img src="/images/frame/readtimeo.PNG" alt="Reading time" class="blog-card__icon" />
                    <span>{readTime}</span>
                  </span>
                  <span class="blog-card__sep" aria-hidden="true">|</span>
                  <span class="blog-card__date">{date}</span>
                </div>
              </div>

            </div>
          </article>
        );
      })}
    </section>

  </main>

  <!-- Modal shell -->
  <ContentModal />

  <!-- Pre-rendered post bodies (hidden, read by modal JS) -->
  <div id="post-bodies" hidden aria-hidden="true">
    {postsWithHtml.map(({ post, Content }) => (
      <div data-post-body={post.id}><Content /></div>
    ))}
  </div>

  <script define:vars={{ modalPosts }}>
    const bc = document.getElementById('post-bodies');
    window.__contentPosts = modalPosts.map(p => ({
      ...p,
      bodyHtml: bc?.querySelector(`[data-post-body="${p.id}"]`)?.innerHTML ?? `<p>${p.description}</p>`,
    }));
  </script>

  <script type="module">
    import { initContentModal } from '/src/js/content-modal.js';
    document.addEventListener('DOMContentLoaded', () => initContentModal());
  </script>

</body>
</html>

<style>
/* ======================================================
   RESET & BASE
====================================================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: #f5ede0;
  font-family: 'Special Elite', 'Courier New', monospace;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ======================================================
   VIEWPORT FRAME (frame.PNG via border-image)
   Fixed overlay — stays put as content scrolls underneath
====================================================== */
.blog-frame {
  position: fixed;
  inset: 0;
  z-index: 100;
  pointer-events: none;

  border-style: solid;
  border-width: clamp(16px, 3.5vw, 44px);
  border-image-source: url('/images/frame/frame.PNG');
  border-image-slice: 7% 6% 6% 5% fill;
  border-image-repeat: round;
  border-image-width: clamp(16px, 3.5vw, 44px);
}

/* ======================================================
   FIXED DECORATIVES
====================================================== */
.deco {
  position: fixed;
  z-index: 110;
  pointer-events: none;
  user-select: none;
}

/* Top-left palm tree */
.deco--treeleft {
  top: -3%;
  left: -1%;
  width: clamp(120px, 18vw, 260px);
  height: auto;
}

/* Top-right palm tree */
.deco--treeright {
  top: -3%;
  right: -1%;
  width: clamp(110px, 16vw, 240px);
  height: auto;
}

/* Bottom-left arch ornament */
.deco--frameleft {
  bottom: 0;
  left: 0;
  width: clamp(80px, 14vw, 200px);
  height: auto;
}

/* Bottom-right flag ornament */
.deco--frameright {
  bottom: 0;
  right: 0;
  width: clamp(44px, 7vw, 110px);
  height: auto;
}

/* Lilly — sits on bottom-left, in front of frameleft */
.deco--lilly {
  bottom: clamp(4px, 2vw, 32px);
  left: clamp(64px, 12vw, 180px);
  width: clamp(100px, 15vw, 210px);
  height: auto;
  z-index: 115;
}

/* ======================================================
   PAGE LAYOUT
====================================================== */
.blog-page {
  position: relative;
  z-index: 5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(20px, 4vh, 44px);
  padding:
    clamp(56px, 9vh, 100px)
    clamp(48px, 9vw, 130px)
    clamp(130px, 22vh, 230px)
    clamp(48px, 9vw, 130px);
}

/* ======================================================
   BLOG LOGO (top-center)
====================================================== */
.blog-header {
  width: 100%;
  display: flex;
  justify-content: center;
}

.blog-logo {
  width: clamp(200px, 48vw, 540px);
  height: auto;
  display: block;
}

/* ======================================================
   CARD GRID (flex wrap — 3→2→1 cols)
====================================================== */
.blog-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: clamp(14px, 3vw, 32px);
  width: 100%;
}

/* ======================================================
   BLOG CARD
====================================================== */
.blog-card {
  position: relative;           /* for maximize button positioning */
  flex: 0 1 clamp(170px, 24vw, 260px);
  min-width: 170px;
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.blog-card:hover {
  transform: translateY(-7px);
}

/* Maximize button — top-right corner of card, outside border */
.blog-card__maximize {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 28px;
  height: 28px;
  padding: 0;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 10;
  opacity: 0.85;
  transition: opacity 0.18s, transform 0.18s;
}
.blog-card__maximize:hover {
  opacity: 1;
  transform: scale(1.2);
}
.blog-card__maximize img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* Hand-drawn border from blogborder.PNG */
.blog-card__inner {
  display: flex;
  flex-direction: column;
  background: #f5ede0;
  border-style: solid;
  border-color: transparent;
  border-width: 20px 17px 22px 17px;
  border-image-source: url('/images/frame/blogborder.PNG');
  border-image-slice: 16 13 16 13 fill;
  border-image-repeat: stretch;
}

/* ======================================================
   IMAGE ZONE
   clip-path octagon matching the blogimagemask corners
====================================================== */
.blog-card__img-wrap {
  width: 100%;
  aspect-ratio: 3 / 3.4;
  overflow: hidden;
  clip-path: polygon(
    10% 0%, 90% 0%,
    100% 10%, 100% 90%,
    90% 100%, 10% 100%,
    0% 90%, 0% 10%
  );
}

.blog-card__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.blog-card:hover .blog-card__img {
  transform: scale(1.05);
}

/* ======================================================
   CARD BODY
====================================================== */
.blog-card__body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 6px 4px;
}

.blog-card__title {
  font-family: 'Special Elite', 'Courier New', monospace;
  font-size: clamp(11px, 1.7vw, 14px);
  font-weight: 700;
  color: #d64e2c;
  line-height: 1.25;
  margin: 0;
  /* clamp to 2 lines */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Thin divider line between title and meta */
.blog-card__divider {
  display: block;
  width: 100%;
  height: 3px;
  background: url('/images/frame/cardbreak.PNG') center / 100% 100% no-repeat;
  margin: 1px 0;
}

/* Meta: views | read time | date */
.blog-card__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 3px 4px;
  font-size: clamp(9px, 1.15vw, 11px);
  color: #d64e2c;
  line-height: 1;
}

.blog-card__meta-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.blog-card__icon {
  width: 12px;
  height: 12px;
  object-fit: contain;
  flex-shrink: 0;
  display: block;
}

.blog-card__sep {
  opacity: 0.45;
  font-size: 10px;
}

.blog-card__date {
  white-space: nowrap;
  font-size: clamp(9px, 1.1vw, 11px);
  color: #d64e2c;
  opacity: 0.9;
}

/* ======================================================
   RESPONSIVE BREAKPOINTS
====================================================== */
@media (max-width: 720px) {
  .blog-page {
    padding-left:  clamp(30px, 7vw, 72px);
    padding-right: clamp(30px, 7vw, 72px);
    padding-bottom: clamp(100px, 18vh, 180px);
  }
  .deco--treeleft  { width: clamp(80px, 22vw, 150px); }
  .deco--treeright { width: clamp(75px, 20vw, 140px); }
  .deco--frameleft { width: clamp(56px, 16vw, 110px); }
  .deco--frameright{ width: clamp(36px, 10vw, 72px); }
  .deco--lilly     { width: clamp(76px, 17vw, 140px); left: clamp(46px, 13vw, 120px); }
  .blog-card       { flex: 0 1 calc(50% - 10px); min-width: 140px; }
}

@media (max-width: 460px) {
  .blog-page {
    padding-left:  24px;
    padding-right: 24px;
    padding-bottom: 130px;
  }
  .blog-frame { border-width: 13px; }
  .blog-card  { flex: 0 1 100%; max-width: 280px; }
  .deco--treeleft  { width: 85px; }
  .deco--treeright { width: 78px; }
  .deco--frameleft { width: 56px; }
  .deco--frameright{ width: 36px; }
  .deco--lilly     { width: 100px; left: 20px; }
}
</style>
