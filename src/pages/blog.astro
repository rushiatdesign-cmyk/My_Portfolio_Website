---
/**
 * blog.astro  — /blog
 * Uses BlogFrame (page shell) + FrameCard (card) components.
 * This file is now ONLY data-fetching + component composition.
 */
import { getCollection, render } from 'astro:content';
import { calcReadingTime } from '../components/content/ReadingTime.ts';
import BlogFrame from '../components/content/BlogFrame.astro';
import FrameCard from '../components/content/FrameCard.astro';
import ContentModal from '../components/content/ContentModal.astro';

const rawPosts = await getCollection('blog');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const postsWithHtml = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);

const modalPosts = postsWithHtml.map(({ post }) => ({
  id:          post.id,
  title:       post.data.title,
  description: post.data.description,
  image:       post.data.image,
  publishDate: post.data.publishDate.toISOString(),
  tags:        post.data.tags ?? [],
  views:       post.data.views ?? 0,
  readingTime: calcReadingTime(post.body ?? ''),
  bodyHtml:    null,
}));

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<BlogFrame
  pageTitle="Blog — Portfolio"
  description="Essays, notes, and observations on design, process, and making things."
  logoSrc="/images/frame/bloglogo.PNG"
  logoAlt="Blog"
  bgColor="#f5ede0"
  decos={{
    frameSrc:      '/images/frame/frame.PNG',
    frameSlice:    '7% 6% 6% 5%',
    treeleftSrc:   '/images/frame/treeleft.PNG',
    treeRightSrc:  '/images/frame/treeright.PNG',
    frameLeftSrc:  '/images/frame/frameleft.PNG',
    frameRightSrc: '/images/frame/frameright.PNG',
    lillySrc:      '/images/frame/lilly.PNG',
  }}
>

  <!-- ── Cards (default slot → rendered into .bf-grid) ── -->
  {sortedPosts.map((post) => (
    <FrameCard
      postId={post.id}
      contentType="blog"
      title={post.data.title}
      image={post.data.image}
      views={post.data.views ?? 0}
      readingTime={calcReadingTime(post.body ?? '')}
      date={fmtDate(post.data.publishDate)}
      description={post.data.description}

      borderSrc="/images/frame/blogborder.PNG"
      borderSlice="16 13 16 13"
      borderWidth="20px 17px 22px 17px"
      clipVariant="octagon"

      viewsIconSrc="/images/frame/viewso.PNG"
      readIconSrc="/images/frame/readtimeo.PNG"
      expandIconSrc="/images/frame/maximizeo.PNG"
      dividerSrc="/images/frame/cardbreak.PNG"

      accentColor="#d64e2c"
      cardBg="#f5ede0"
    />
  ))}

  <!-- ── Modal + scripts (scripts slot) ── -->
  <Fragment slot="scripts">
    <ContentModal />

    <div id="post-bodies" hidden aria-hidden="true">
      {postsWithHtml.map(({ post, Content }) => (
        <div data-post-body={post.id}><Content /></div>
      ))}
    </div>

    <script define:vars={{ modalPosts }}>
      const bc = document.getElementById('post-bodies');
      window.__contentPosts = modalPosts.map(p => ({
        ...p,
        bodyHtml: bc?.querySelector(`[data-post-body="${p.id}"]`)?.innerHTML
                  ?? `<p>${p.description}</p>`,
      }));
    </script>

    <script type="module">
      import { initContentModal } from '/src/js/content-modal.js';
      document.addEventListener('DOMContentLoaded', () => initContentModal());
    </script>
  </Fragment>

</BlogFrame>
