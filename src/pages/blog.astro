---
import { getCollection, render } from 'astro:content';
import { calcReadingTime } from '../components/content/ReadingTime.ts';
import BlogLayout from '../layouts/BlogLayout.astro';

const rawPosts = await getCollection('blog');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const postsWithHtml = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<BlogLayout>
  <!-- Blog logo banner — top center -->
  <header class="blog-header">
    <img src="/images/frame/bloglogo.PNG" class="blog-logo" alt="Blog" />
  </header>

  <!-- Card grid -->
  <section class="blog-grid" aria-label="Blog posts">
    {sortedPosts.map((post) => {
      const readTime = calcReadingTime(post.body ?? '');
      const views    = post.data.views ?? 0;
      const date     = fmtDate(post.data.publishDate);
      
      return (
        <a href={`/blog/${post.id}`} class="blog-card" aria-label={`Read: ${post.data.title}`}>
          <!-- Maximize icon sits above the border, top-right -->
          <button class="blog-card__maximize" type="button" aria-label="Open in popup" data-post-id={post.id}>
            <img src="/images/frame/maximizeo.PNG" alt="" />
          </button>

          <!-- Hand-drawn card border (blogborder.PNG) -->
          <div class="blog-card__inner">

            <!-- Photo — cut-corner shape via clip-path -->
            <div class="blog-card__img-wrap">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="blog-card__img"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Text below image -->
            <div class="blog-card__body">
              <h2 class="blog-card__title">{post.data.title}</h2>
              <span class="blog-card__divider" aria-hidden="true"></span>
              <div class="blog-card__meta">
                <span class="blog-card__meta-item">
                  <img src="/images/frame/viewso.PNG" alt="Views" class="blog-card__icon" />
                  <span>{views}</span>
                </span>
                <span class="blog-card__sep" aria-hidden="true">|</span>
                <span class="blog-card__meta-item">
                  <img src="/images/frame/readtimeo.PNG" alt="Reading time" class="blog-card__icon" />
                  <span>{readTime}</span>
                </span>
                <span class="blog-card__sep" aria-hidden="true">|</span>
                <span class="blog-card__date">{date}</span>
              </div>
            </div>

          </div>
        </a>
      );
    })}
  </section>

  <!-- Modal Shell -->
  <div id="blog-modal" class="blog-modal-overlay" aria-hidden="true">
    <div class="blog-modal-panel" role="dialog" aria-modal="true">
      <button id="blog-modal-close" class="blog-modal-close" aria-label="Close modal">
        <img src="/images/frame/closeo.PNG" alt="Close" />
      </button>
      
      <article class="blog-post-content">
        <h1 id="bm-title"></h1>
        <div class="blog-post-meta">
          <span class="blog-card__meta-item">
            <img src="/images/frame/viewso.PNG" alt="Views" class="blog-card__icon" />
            <span id="bm-views"></span>
          </span>
          <span class="blog-card__meta-item">
            <img src="/images/frame/readtimeo.PNG" alt="Reading time" class="blog-card__icon" />
            <span id="bm-read"></span>
          </span>
          <span id="bm-date"></span>
        </div>
        <img id="bm-hero" src="" alt="" class="blog-post-hero" />
        <div id="bm-body" class="blog-post-body"></div>
      </article>
    </div>
  </div>

  <!-- Hidden Content for JS to read -->
  <div id="blog-hidden-content" hidden>
    {postsWithHtml.map(({ post, Content }) => {
      const readTime = calcReadingTime(post.body ?? '');
      const views = post.data.views ?? 0;
      const date = fmtDate(post.data.publishDate);
      return (
        <div data-content-id={post.id}>
          <div class="hc-title">{post.data.title}</div>
          <div class="hc-views">{views} views</div>
          <div class="hc-read">{readTime}</div>
          <div class="hc-date">{date}</div>
          <div class="hc-image">{post.data.image ?? ''}</div>
          <div class="hc-body"><Content /></div>
        </div>
      );
    })}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('blog-modal')!;
      const closeBtn = document.getElementById('blog-modal-close')!;
      const hiddenContainer = document.getElementById('blog-hidden-content')!;
      
      const bmTitle = document.getElementById('bm-title')!;
      const bmViews = document.getElementById('bm-views')!;
      const bmRead = document.getElementById('bm-read')!;
      const bmDate = document.getElementById('bm-date')!;
      const bmHero = document.getElementById('bm-hero') as HTMLImageElement;
      const bmBody = document.getElementById('bm-body')!;

      // Open modal when maximize button is clicked
      document.querySelectorAll('.blog-card__maximize').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault(); // Prevent following the card link
          e.stopPropagation();
          
          const postId = btn.getAttribute('data-post-id');
          const dataDiv = hiddenContainer.querySelector(`[data-content-id="${postId}"]`);
          if (!dataDiv) return;

          // Populate modal
          bmTitle!.textContent = dataDiv.querySelector('.hc-title')!.textContent;
          bmViews!.textContent = dataDiv.querySelector('.hc-views')!.textContent;
          bmRead!.textContent = dataDiv.querySelector('.hc-read')!.textContent;
          bmDate!.textContent = dataDiv.querySelector('.hc-date')!.textContent;
          
          const imgSrc = dataDiv.querySelector('.hc-image')!.textContent;
          if (imgSrc) {
            bmHero!.src = imgSrc;
            bmHero!.style.display = 'block';
          } else {
            bmHero!.style.display = 'none';
          }

          bmBody!.innerHTML = dataDiv.querySelector('.hc-body')!.innerHTML;

          // Set translation vector for pop-out animation
          const card = btn.closest('.blog-card');
          if (card) {
            const rect = card.getBoundingClientRect();
            const cardCenterX = rect.left + rect.width / 2;
            const cardCenterY = rect.top + rect.height / 2;
            
            const viewportCenterX = window.innerWidth / 2;
            const viewportCenterY = window.innerHeight / 2;
            
            const tx = cardCenterX - viewportCenterX;
            const ty = cardCenterY - viewportCenterY;
            
            const modalPanel = modal.querySelector('.blog-modal-panel') as HTMLElement;
            if (modalPanel) {
              modalPanel.style.setProperty('--tx', `${tx}px`);
              modalPanel.style.setProperty('--ty', `${ty}px`);
            }
          }

          // Show modal
          modal.classList.add('is-active');
          document.body.style.overflow = 'hidden'; // lock scroll
          document.body.classList.add('modal-open');
        });
      });

      // Close modal logic
      const closeModal = () => {
        modal.classList.remove('is-active');
        document.body.style.overflow = ''; // unlock scroll
        document.body.classList.remove('modal-open');
      };

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal(); // close if clicking overlay backdrop
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    });
  </script>
</BlogLayout>
