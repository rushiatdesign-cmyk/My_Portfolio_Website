---
/**
 * work.astro — /work
 */
import { getCollection } from 'astro:content';
import '../styles/work.css';

const rawPosts = await getCollection('work');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <title>Work — Portfolio</title>
  <meta name="description" content="Projects and case studies." />
</head>
<body class="work-page">
  <nav class="work-nav" aria-label="Site navigation">
    <a href="/" class="work-nav__logo">Portfolio</a>
    <ul class="work-nav__links">
      <li><a href="/blog">Blog</a></li>
      <li><a href="/work" aria-current="page">Work</a></li>
      <li><a href="/gallery">Gallery</a></li>
      <li><a href="/stuff">Stuff</a></li>
    </ul>
  </nav>
  
  <main class="work-main">
    <h1>Work</h1>
    <div class="work-grid">
      {sortedPosts.map(post => (
        <a href={`/work/${post.id}`} class="work-card">
          <h2>{post.data.title}</h2>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
