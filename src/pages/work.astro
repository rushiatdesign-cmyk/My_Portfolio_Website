---
/**
 * work.astro — /work
 * Same architecture as blog.astro; different border/mask variants.
 */
import { getCollection, render } from 'astro:content';
import { calcReadingTime } from '../components/content/ReadingTime.ts';
import ContentGrid from '../components/content/ContentGrid.astro';
import ContentModal from '../components/content/ContentModal.astro';
import '../styles/content-system.css';

const rawPosts = await getCollection('work');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const postsWithHtml = await Promise.all(
  sortedPosts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);

const gridPosts = sortedPosts.map((post) => ({
  id:          post.id,
  title:       post.data.title,
  description: post.data.description,
  image:       post.data.image,
  publishDate: post.data.publishDate,
  tags:        post.data.tags,
  views:       post.data.views,
  body:        post.body ?? '',
}));

const modalPosts = postsWithHtml.map(({ post }) => ({
  id:          post.id,
  title:       post.data.title,
  description: post.data.description,
  image:       post.data.image,
  publishDate: post.data.publishDate.toISOString(),
  tags:        post.data.tags,
  views:       post.data.views,
  readingTime: calcReadingTime(post.body ?? ''),
  bodyHtml:    null,
}));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <title>Work — Portfolio</title>
  <meta name="description" content="Selected projects and case studies." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root { --cs-font-serif: 'Playfair Display', Georgia, serif; --cs-font-mono: 'JetBrains Mono', 'Courier New', monospace; }
    * { box-sizing: border-box; }
    body { margin: 0; }
  </style>
</head>
<body class="cs-page">
  <nav class="cs-nav" aria-label="Site navigation">
    <a href="/" class="cs-nav__logo">Portfolio</a>
    <ul class="cs-nav__links">
      <li><a href="/blog">Blog</a></li>
      <li><a href="/work" aria-current="page">Work</a></li>
      <li><a href="/gallery">Gallery</a></li>
      <li><a href="/stuff">Stuff</a></li>
    </ul>
  </nav>

  <main id="work-main">
    <ContentGrid
      posts={gridPosts}
      contentType="work"
      heading="Work"
      subheading="Selected projects, case studies, and experiments."
      borderVariant="ink"
      maskVariant="paper"
    />
  </main>

  <ContentModal />

  <div id="post-bodies" hidden aria-hidden="true">
    {postsWithHtml.map(({ post, Content }) => (
      <div data-post-body={post.id}><Content /></div>
    ))}
  </div>

  <script define:vars={{ modalPosts }}>
    const bodyContainer = document.getElementById('post-bodies');
    window.__contentPosts = modalPosts.map(post => ({
      ...post,
      bodyHtml: bodyContainer?.querySelector(`[data-post-body="${post.id}"]`)?.innerHTML
                ?? `<p>${post.description}</p>`,
    }));
  </script>

  <script type="module">
    import { initContentModal } from '/src/js/content-modal.js';
    document.addEventListener('DOMContentLoaded', () => initContentModal());
  </script>
</body>
</html>
