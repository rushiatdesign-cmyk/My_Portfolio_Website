---
import { getCollection } from 'astro:content';
import WorkLayout from '../layouts/WorkLayout.astro';
import WorkCard from '../components/work/WorkCard.astro';
import TopNav from '../components/navigation/TopNav.astro';

const rawProjects = await getCollection('work');
const sortedProjects = rawProjects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<WorkLayout>
  <!-- Work logo banner — top center -->
  <header class="work-header">
    <TopNav />
    <div class="work-logo" aria-label="Work"></div>
  </header>

  <div class="work-layout-content">
    <div class="work-projects-list">
      {sortedProjects.map(project => (
        <WorkCard project={project} />
      ))}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Header scroll hide/show logic
      let lastScrollY = window.scrollY;
      const header = document.querySelector('.work-header');

      window.addEventListener('scroll', () => {
        if (!header) return;
        const currentScrollY = window.scrollY;
        if (currentScrollY > lastScrollY && currentScrollY > 10) {
          header.classList.add('is-hidden');
        } else {
          header.classList.remove('is-hidden');
        }
        lastScrollY = currentScrollY;
      }, { passive: true });
    });
  </script>
</WorkLayout>
