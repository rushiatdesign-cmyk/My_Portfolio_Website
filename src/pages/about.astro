---
import { getCollection, render } from 'astro:content';
import { calcReadingTime } from '../components/content/ReadingTime.ts';
import AboutLayout from '../layouts/AboutLayout.astro';
import TopNav from '../components/navigation/TopNav.astro';

const rawPosts = await getCollection('blog');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const postsWithHtml = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<AboutLayout>
  <!-- About logo banner — top center -->
  <header class="about-header">
    <TopNav />
    <div class="about-logo" aria-label="About"></div>
  </header>

  <div class="about-hero-section">
    <div class="about-hero-content">
      <img src="/Images/about/mycharacter.PNG" alt="Rushi Character" class="about-character-img" />
      
      <div class="about-text-content">
        <p>Hey there, I am Rushi &amp; I am a Designer. I am lazy &amp; this is your sign to hire me. Oh, you are reading it here lets collab now! Hey there, I am Rushi &amp; I am a Designer. I am lazy &amp; this is your sign to hire me. Oh, you are reading it here lets collab now! Hey there, I am Rushi &amp; I am a Designer. I am lazy &amp; this is your sign to hire me. Oh, you are reading it here lets collab now! Hey there, I am Rushi &amp; I am a Designer. I am lazy &amp; this is your sign to hire me. Oh, you are reading it here lets collab now!</p>
      </div>
    </div>

    <div class="about-quote-section">
      <p class="about-quote-text">
        To know more<br>about me u<br>should contact me,
      </p>
      <div class="about-quote-arrow">
        Here is the button ⤵
      </div>
      
      <a href="mailto:rushi@example.com" class="about-contact-btn">
        <span class="btn-text">Right here</span>
        <div class="btn-border"></div>
        <div class="btn-border-inner"></div>
      </a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Header scroll hide/show logic
      let lastScrollY = window.scrollY;
      const header = document.querySelector('.about-header');

      window.addEventListener('scroll', () => {
        if (!header) return;
        const currentScrollY = window.scrollY;
        if (currentScrollY > lastScrollY && currentScrollY > 150) {
          header.classList.add('is-hidden');
        } else {
          header.classList.remove('is-hidden');
        }
        lastScrollY = currentScrollY;
      }, { passive: true });
    });
  </script>
</AboutLayout>
