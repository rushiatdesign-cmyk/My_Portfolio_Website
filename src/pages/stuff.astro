---
/**
 * stuff.astro — /stuff
 */
import { getCollection } from 'astro:content';
import '../styles/stuff.css';

const rawPosts = await getCollection('stuff');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <title>Stuff — Portfolio</title>
  <meta name="description" content="Assorted things." />
</head>
<body class="stuff-page">
  <nav class="stuff-nav" aria-label="Site navigation">
    <a href="/" class="stuff-nav__logo">Portfolio</a>
    <ul class="stuff-nav__links">
      <li><a href="/blog">Blog</a></li>
      <li><a href="/work">Work</a></li>
      <li><a href="/gallery">Gallery</a></li>
      <li><a href="/stuff" aria-current="page">Stuff</a></li>
    </ul>
  </nav>
  
  <main class="stuff-main">
    <h1>Stuff</h1>
    <div class="stuff-grid">
      {sortedPosts.map(post => (
        <a href={`/stuff/${post.id}`} class="stuff-card">
          <h2>{post.data.title}</h2>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
