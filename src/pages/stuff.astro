---
import StuffLayout from '../layouts/StuffLayout.astro';
import StuffCard from '../components/stuff/StuffCard.astro';
import StuffModal from '../components/stuff/StuffModal.astro';

import MoviesContent from '../components/stuff/popups/MoviesContent.astro';
import DishesContent from '../components/stuff/popups/DishesContent.astro';
import MusicContent from '../components/stuff/popups/MusicContent.astro';
import PhotographsContent from '../components/stuff/popups/PhotographsContent.astro';
import IllustrationsContent from '../components/stuff/popups/IllustrationsContent.astro';

const cards = [
  { id: 'stuff-modal-movies',        title: 'Movies',        emoji: '🎬', index: 0 },
  { id: 'stuff-modal-dishes',        title: 'Dishes',        emoji: '🥘', index: 1 },
  { id: 'stuff-modal-music',         title: 'Music',         emoji: '🎵', index: 2 },
  { id: 'stuff-modal-photographs',   title: 'Photographs',   emoji: '📷', index: 3 },
  { id: 'stuff-modal-illustrations', title: 'Illustrations', emoji: '🎨', index: 4 }
];
---

<StuffLayout>
  <!-- Card carousel -->
  <div class="stuff-carousel-wrap">
    <div id="stuff-track" class="stuff-track">
      {cards.map(c => (
        <StuffCard
          modalId={c.id}
          title={c.title}
          emoji={c.emoji}
          index={c.index}
        />
      ))}
    </div>
  </div>

  <!-- One modal per card -->
  <Fragment slot="modals">
    <StuffModal id="stuff-modal-movies" borderColor="#F5C842">
      <MoviesContent />
    </StuffModal>

    <StuffModal id="stuff-modal-dishes" borderColor="#F5C842">
      <DishesContent />
    </StuffModal>

    <StuffModal id="stuff-modal-music" borderColor="#F5C842" bgColor="#F5C842" closeIconColor="#0D1855">
      <MusicContent />
    </StuffModal>

    <StuffModal id="stuff-modal-photographs" borderColor="#F5C842">
      <PhotographsContent />
    </StuffModal>

    <StuffModal id="stuff-modal-illustrations" borderColor="#F5C842">
      <IllustrationsContent />
    </StuffModal>
  </Fragment>
</StuffLayout>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {

    /* ─── Horizontal card carousel ─── */
    const track = document.getElementById('stuff-track') as HTMLElement;
    const leftBtn = document.getElementById('stuff-arrow-left') as HTMLButtonElement;
    const rightBtn = document.getElementById('stuff-arrow-right') as HTMLButtonElement;

    let currentIndex = 0;
    const TOTAL = 5;

    // Dynamically calculate visible cards (1 on mobile, 3 on desktop)
    const getVisibleCount = () => window.innerWidth <= 768 ? 1 : 3;
    let VISIBLE = getVisibleCount();
    let MAX_INDEX = TOTAL - VISIBLE;

    const getCardWidth = () => {
      const card = track.querySelector<HTMLElement>('.stuff-card');
      if (!card) return 0;
      const gap = parseFloat(getComputedStyle(track).gap || '0');
      return card.offsetWidth + gap;
    };

    const slide = () => {
      gsap.to(track, {
        x: -(currentIndex * getCardWidth()),
        duration: 0.65,
        ease: 'power2.inOut',
      });
    };

    const updateArrows = () => {
      leftBtn.style.opacity = currentIndex === 0 ? '0.35' : '1';
      rightBtn.style.opacity = currentIndex >= MAX_INDEX ? '0.35' : '1';
    };

    window.addEventListener('resize', () => {
      VISIBLE = getVisibleCount();
      MAX_INDEX = TOTAL - VISIBLE;
      if (currentIndex > MAX_INDEX) currentIndex = MAX_INDEX;
      slide();
      updateArrows();
    });

    const goNext = () => {
      if (currentIndex >= MAX_INDEX) return;
      currentIndex++;
      slide();
      updateArrows();
    };

    const goPrev = () => {
      if (currentIndex <= 0) return;
      currentIndex--;
      slide();
      updateArrows();
    };

    rightBtn.addEventListener('click', goNext);
    leftBtn.addEventListener('click', goPrev);

    updateArrows();

    /* ─── Pointer Drag/Swipe ─── */
    let startX = 0;
    let isDragging = false;
    let dragThreshold = 50;

    track.addEventListener('pointerdown', (e) => {
      isDragging = true;
      startX = e.clientX;
    });

    const handlePointerEnd = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      
      const diffX = e.clientX - startX;
      
      // If horizontal swipe distance crosses threshold, switch slides
      if (diffX > dragThreshold) {
        goPrev();
      } else if (diffX < -dragThreshold) {
        goNext();
      }
    };

    window.addEventListener('pointerup', handlePointerEnd);
    window.addEventListener('pointercancel', handlePointerEnd);

    /* ─── Wheel / Trackpad Scroll ─── */
    let lastWheelTime = 0;

    document.addEventListener('wheel', (e) => {
      // Disable if a modal is open
      if (document.body.style.overflow === 'hidden') return;

      const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      
      // Ignore tiny resting movements
      if (Math.abs(delta) < 15) return;

      const now = Date.now();
      // Enforce a 350ms cooldown between slides so trackpad swipes don't rapid-fire, 
      // but the first movement responds instantly
      if (now - lastWheelTime < 350) return;

      if (delta > 0 && currentIndex < MAX_INDEX) {
        currentIndex++;
        slide();
        updateArrows();
        lastWheelTime = now;
      } else if (delta < 0 && currentIndex > 0) {
        currentIndex--;
        slide();
        updateArrows();
        lastWheelTime = now;
      }
    });

    /* ─── Modal open / close ─── */
    const allModals = document.querySelectorAll<HTMLElement>('[data-stuff-modal]');

    const openModal = (id: string) => {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = (modal: HTMLElement) => {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('.stuff-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.dataset.modal;
        if (id) openModal(id);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-stuff-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        const modal = btn.closest<HTMLElement>('[data-stuff-modal]');
        if (modal) closeModal(modal);
      });
    });

    allModals.forEach(modal => {
      modal.addEventListener('click', e => {
        if (e.target === modal) closeModal(modal);
      });
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        allModals.forEach(modal => {
          if (modal.classList.contains('is-active')) closeModal(modal);
        });
      }
    });
  });
</script>
