---
import { getCollection, render } from 'astro:content';
import WorkLayout from '../../layouts/WorkLayout.astro';
import '../../styles/blog-card.css';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const date = project.data.publishDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<WorkLayout pageTitle={`${project.data.title} — Work`} description={project.data.description}>
  <article class="blog-post-content" style="background-color: transparent; padding-top: 60px;">
    <a href="/work" style="display: inline-block; margin-bottom: 24px; color: #0B2838; text-decoration: none; font-family: 'Slackey', cursive; font-size: 14px;">
      ← Back to Work
    </a>

    <h1 style="color: #0B2838; font-family: 'Slackey', cursive; line-height: 1.1; margin-bottom: 20px;">{project.data.title}</h1>
    
    <div style="display: flex; gap: 24px; margin-bottom: 40px; font-family: 'EB Garamond', serif; font-size: 18px; color: rgba(11, 40, 56, 0.8);">
      <span>{date}</span>
      {project.data.client && <span><strong>Client:</strong> {project.data.client}</span>}
      {project.data.role && <span><strong>Role:</strong> {project.data.role}</span>}
    </div>

    {project.data.image && (
      <div style="width: 100%; border-radius: 8px; overflow: hidden; margin-bottom: 40px; border: 20px solid transparent; border-image: url('/images/work/work_border.PNG') 25% 8% round; -webkit-mask-box-image-source: url('/images/work/workimagemask.PNG'); -webkit-mask-box-image-slice: 15% 10% 12% fill; -webkit-mask-box-image-width: 12px; -webkit-mask-box-image-repeat: stretch;">
        <img src={project.data.image} alt="" style="width: 100%; height: auto; display: block;" />
      </div>
    )}

    <div class="blog-post-body" style="font-family: 'EB Garamond', serif; font-size: 20px; line-height: 1.6; color: rgba(11, 40, 56, 0.9);">
      <Content />
    </div>
  </article>
</WorkLayout>
