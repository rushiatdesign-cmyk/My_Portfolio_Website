---
/**
 * gallery.astro — /gallery
 */
import { getCollection } from 'astro:content';
import '../styles/gallery.css';

const rawPosts = await getCollection('gallery');
const sortedPosts = rawPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <title>Gallery — Portfolio</title>
  <meta name="description" content="Photography, illustration, and visual work." />
</head>
<body class="gallery-page">
  <nav class="gallery-nav" aria-label="Site navigation">
    <a href="/" class="gallery-nav__logo">Portfolio</a>
    <ul class="gallery-nav__links">
      <li><a href="/blog">Blog</a></li>
      <li><a href="/work">Work</a></li>
      <li><a href="/gallery" aria-current="page">Gallery</a></li>
      <li><a href="/stuff">Stuff</a></li>
    </ul>
  </nav>
  
  <main class="gallery-main">
    <h1>Gallery</h1>
    <div class="gallery-grid">
      {sortedPosts.map(post => (
        <a href={`/gallery/${post.id}`} class="gallery-card">
          <h2>{post.data.title}</h2>
          {post.data.image && <img src={post.data.image} alt="" />}
        </a>
      ))}
    </div>
  </main>
</body>
</html>
