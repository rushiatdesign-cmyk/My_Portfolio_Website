---
// Music popup content
---

<style is:inline>
  :root {
    --bg-page: transparent;
    --card-red: #8a2417;
    --ink: #111010;
    --cream: #f6e8bd;
    --label-yellow: #f0cf6b;
    --arm-grey: #75746f;
    --arm-grey-dark: #4a4946;
    --accent: #e8b23d;
  }

  * {
    box-sizing: border-box;
  }

  .vinyl-widget {
    width: 100%;
    max-width: 880px;
    min-height: 90vh; /* Force it to take up most of the screen to vertically center */
    margin: 0 auto; /* Horizontally center within the modal body */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .player-layout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2vw, 28px);
    width: 100%;
    flex-wrap: wrap;
  }

  .art-wrap {
    flex: 1 1 280px;
    min-width: 250px;
    max-width: 380px;
    margin: 0 32px; /* Balance margins with .controls for perfect centering */
  }

  @media (max-width: 720px) {
    .vinyl-widget {
      padding-top: 80px; /* Space at the top to prevent it from hugging the close button */
      padding-bottom: 40px;
    }
    .player-layout {
      flex-direction: column;
      align-items: center;
    }
    .art-wrap {
      width: 100%;
      max-width: 380px;
      margin: 0;
    }
    .controls {
      margin-top: 32px;
      margin-bottom: 32px;
      padding: 18px 18px 16px;
      width: calc(
        100% - 64px
      ); /* Subtract inherited left/right margins to prevent off-center spilling */
      max-width: 420px;
    }
  }

  /* ================= SVG ARTWORK ================= */
  .art {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    overflow: visible;
  }

  #diskGroup {
    transform-box: view-box;
    transform-origin: 515px 460px;
    animation: spin 1.8s linear infinite;
    animation-play-state: paused;
  }
  .art.spinning #diskGroup {
    animation-play-state: running;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  #tonearmGroup {
    transform-box: view-box;
    transform-origin: 955px 288px;
    transform: rotate(-16deg);
    transition: transform 0.7s cubic-bezier(0.34, 1.25, 0.4, 1);
  }
  .art.spinning #tonearmGroup {
    transform: rotate(0deg);
  }

  #labelCover {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #labelCover.loaded {
    opacity: 1;
  }

  #labelTitleText {
    fill: #fff;
    font-size: 26px;
    font-weight: 700;
    font-family: "Segoe UI", system-ui, sans-serif;
  }

  #playGlyph {
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .disk-wrap-hover:hover #playGlyph {
    opacity: 1;
  }

  /* ================= CONTROLS ================= */
  .controls {
    flex: 1 1 270px;
    min-width: 0;
    max-width: 320px;
    background: transparent;
    border-radius: 0;
    padding: 18px 20px 16px;
    position: relative;
    z-index: 1;
    margin: 38px 32px 42px 32px; /* Make space for the negative absolute positioning */
  }

  .controls::before {
    content: "";
    position: absolute;
    /* Inner cream card, slightly larger than the content */
    top: -10px;
    right: -10px;
    bottom: -10px;
    left: -10px;
    pointer-events: none;
    background-color: #0d1855;
    z-index: -1;

    -webkit-mask-image: url("/images/stuff/stuffcardinside.PNG");
    -webkit-mask-size: 100% 100%;

    mask-image: url("/images/stuff/stuffcardinside.PNG");
    mask-size: 100% 100%;
  }

  .controls::after {
    content: "";
    position: absolute;
    /* Outer blue border, positioned outside the inner card with an 8px gap */
    top: -30px;
    right: -25px;
    bottom: -36px;
    left: -25px;
    pointer-events: none;
    background-color: #0d1855;

    -webkit-mask-box-image-source: url("/images/stuff/stuffborder.PNG");
    -webkit-mask-box-image-slice: 8% 12% 9% 12%;
    -webkit-mask-box-image-width: 20px 14px 24px 14px;
    -webkit-mask-box-image-repeat: stretch;

    mask-border-source: url("/images/stuff/stuffborder.PNG");
    mask-border-slice: 8% 12% 9% 12%;
    mask-border-width: 20px 14px 24px 14px;
    mask-border-repeat: stretch;
  }

  .top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 11px;
  }
  .now-playing .t {
    font-weight: 800;
    font-size: 15px;
    color: #f5c842;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
    transition: opacity 0.25s ease;
  }
  .now-playing .a {
    font-size: 11px;
    color: rgba(245, 200, 66, 0.7);
    margin-top: 2px;
  }
  .now-playing .t.fading {
    opacity: 0;
  }
  .time-display {
    font-size: 12px;
    color: rgba(245, 200, 66, 0.7);
    white-space: nowrap;
    padding-top: 2px;
  }

  .buffering-line {
    text-align: left;
    font-size: 9px;
    color: #f5c842;
    opacity: 0.65;
    min-height: 11px;
    margin-bottom: 2px;
  }
  .buffering-line.show::after {
    content: "Buffering…";
    animation: pulse 1.1s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  .progress-bar {
    height: 11px;
    border-radius: 0;
    border: 2px solid #f5c842;
    background: #0d1855;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background: #f5c842;
  }

  .buttons-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .transport {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: none;
  }
  .btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #f5c842;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .btn.circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f0cf6b;
    color: #0d1855;
    border: 0.5px solid #0d1855;
    flex: none;
  }
  .btn.circle:hover {
    filter: brightness(1.2);
  }
  .btn.circle:active {
    transform: translateY(1px);
  }

  .btn.play-pause {
    width: 48px;
    height: 48px;
    background: #0d1855;
    color: #f5c842;
    border: 0.5px solid #f5c842;
    box-shadow: 0 0 0 2px #f5c842;
  }
  .btn.play-pause svg {
    width: 18px;
    height: 18px;
  }

  .volume {
    display: flex;
    align-items: center;
    flex: 1 1 70px;
    min-width: 50px;
    max-width: 120px;
  }
  .volume input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 3px;
    border-radius: 0;
    outline: none;
    cursor: pointer;
    background: linear-gradient(
      to right,
      #f5c842 0%,
      #f5c842 var(--vol, 100%),
      rgba(245, 200, 66, 0.3) var(--vol, 100%),
      rgba(245, 200, 66, 0.3) 100%
    );
  }
  .volume input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 13px;
    height: 13px;
    border-radius: 0;
    background: #0d1855;
    border: 2px solid #f5c842;
    cursor: pointer;
  }
  .volume input[type="range"]::-moz-range-track {
    height: 3px;
    border-radius: 0;
    background: rgba(245, 200, 66, 0.3);
  }
  .volume input[type="range"]::-moz-range-progress {
    height: 3px;
    border-radius: 0;
    background: #f5c842;
  }
  .volume input[type="range"]::-moz-range-thumb {
    width: 13px;
    height: 13px;
    border-radius: 0;
    background: #0d1855;
    border: 2px solid #f5c842;
    cursor: pointer;
  }

  .status-line {
    text-align: center;
    color: #f5c842;
    opacity: 0.7;
    font-size: 9px;
    margin-top: 10px;
    min-height: 11px;
  }

  /* ================= UPCOMING TRACKS ================= */
  .upcoming {
    margin-top: 13px;
    padding-top: 11px;
    border-top: 2px solid #f5c842;
  }
  .upcoming-heading {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: rgba(245, 200, 66, 0.7);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .upcoming-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-top: 1px solid rgba(245, 200, 66, 0.2);
  }
  .upcoming-row:first-of-type {
    border-top: none;
  }
  .upcoming-row .num {
    font-size: 10px;
    color: rgba(245, 200, 66, 0.7);
    width: 14px;
    flex: none;
  }
  .upcoming-row .info {
    flex: 1;
    min-width: 0;
  }
  .upcoming-row .info .name {
    font-weight: 700;
    font-size: 11px;
    color: #f5c842;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .upcoming-row .info .artist {
    font-size: 10px;
    color: rgba(245, 200, 66, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<section
  class="stuff-popup-content"
  style="width: 100%; min-height: calc(84vh - 100px); display: flex; align-items: center; justify-content: center; padding: 0; margin-top: -20px;"
>
  <div class="vinyl-widget">
    <div class="player-layout">
      <div class="art-wrap">
        <svg
          class="art disk-wrap-hover"
          id="art"
          viewBox="0 0 1205 949"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
        >
          <defs>
            <clipPath id="labelClip">
              <circle cx="500" cy="455" r="138"></circle>
            </clipPath>
            <path
              id="diskTitlePath"
              d="M335,460 A180,180 0 1,1 695,460 A180,180 0 1,1 335,460"
              fill="none"></path>
          </defs>

          <!-- red card -->
          <path
            d="M76,62 L1098,46 L1108,864 L86,880 Z"
            fill="var(--card-red)"
            stroke="var(--ink)"
            stroke-width="10"
            stroke-linejoin="round"></path>

          <!-- static decorative shaft (behind disk) -->
          <line
            x1="1063"
            y1="92"
            x2="1000"
            y2="850"
            stroke="var(--ink)"
            stroke-width="9"
            stroke-linecap="round"></line>
          <line
            x1="1057"
            y1="98"
            x2="994"
            y2="846"
            stroke="var(--accent)"
            stroke-width="3"
            stroke-linecap="round"></line>
          <circle cx="1063" cy="92" r="8" fill="var(--ink)"></circle>

          <!-- static rotated control bar -->
          <g transform="rotate(-15 850 815)">
            <rect
              x="700"
              y="775"
              width="300"
              height="82"
              rx="14"
              fill="var(--ink)"></rect>
            <rect
              x="700"
              y="775"
              width="300"
              height="10"
              rx="5"
              fill="var(--accent)"></rect>
          </g>

          <!-- ===== rotating vinyl disk ===== -->
          <g id="diskGroup">
            <circle cx="515" cy="460" r="425" fill="#0d0c0b"></circle>
            <circle
              cx="515"
              cy="460"
              r="404"
              fill="none"
              stroke="#ffdc85"
              stroke-width="6"></circle>
            <circle
              cx="515"
              cy="460"
              r="335"
              fill="none"
              stroke="#ffdc85"
              opacity="0.6"
              stroke-width="3"></circle>

            <!-- a few subtle glint marks, drawn as true arcs along the ring curvature so they read as light catching the grooves, not stray marks -->
            <path
              d="M135,322 A404,404 0 0,1 224,179"
              stroke="#8a8a8a"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="0.6"></path>
            <path
              d="M377,80 A404,404 0 0,1 487,57"
              stroke="#ffdc85"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="1"></path>
            <path
              d="M172,599 A370,370 0 0,1 146,486"
              stroke="#ffdc85"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="1"></path>
            <path
              d="M833,709 A404,404 0 0,1 729,803"
              stroke="#ffdc85"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="1"></path>
            <path
              d="M476,828 A370,370 0 0,1 370,801"
              stroke="#ffdc85"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="1"></path>

            <!-- track name, curved around the label, spins together with the disk -->
            <text
              id="diskRingText"
              fill="var(--cream)"
              font-size="19"
              font-weight="700"
              opacity="0.6"
              letter-spacing="6"
              style="text-transform:uppercase;"
            >
              <textPath
                id="diskRingTextPath"
                href="#diskTitlePath"
                xlink:href="#diskTitlePath"
                startOffset="0%">—</textPath
              >
            </text>
          </g>

          <!-- ===== static label (does not rotate, stays readable) ===== -->
          <g id="labelGroup">
            <circle cx="500" cy="455" r="140" fill="var(--label-yellow)"
            ></circle>
            <image
              id="labelCover"
              href=""
              x="362"
              y="317"
              width="276"
              height="276"
              clip-path="url(#labelClip)"
              preserveAspectRatio="xMidYMid slice"
            />
            <circle
              cx="500"
              cy="455"
              r="140"
              fill="none"
              stroke="var(--cream)"
              stroke-width="4"></circle>

            <!-- title plate -->
            <rect
              x="365"
              y="560"
              width="270"
              height="46"
              rx="8"
              fill="rgba(17,16,16,0.72)"
              clip-path="url(#labelClip)"></rect>
            <text
              id="labelTitleText"
              x="500"
              y="592"
              text-anchor="middle"
              font-size="20">Loading…</text
            >

            <!-- play/pause glyph shown on hover -->
            <g id="playGlyph" transform="translate(500 455)">
              <circle r="34" fill="rgba(17,16,16,0.55)"></circle>
              <path id="playGlyphPath" d="M-8,-14 L-8,14 L16,0 Z" fill="#fff"
              ></path>
            </g>
          </g>

          <!-- ===== tonearm (rotates around pivot near headshell) ===== -->
          <g id="tonearmGroup">
            <path
              d="M430,548 C415,552 405,540 412,525"
              stroke="var(--cream)"
              stroke-width="14"
              stroke-linecap="round"
              fill="none"></path>
            <line
              x1="425"
              y1="535"
              x2="930"
              y2="300"
              stroke="var(--cream)"
              stroke-width="11"
              stroke-linecap="round"></line>
            <rect
              x="905"
              y="255"
              width="55"
              height="95"
              rx="10"
              fill="var(--cream)"
              transform="rotate(28 932 302)"></rect>
          </g>
        </svg>
      </div>

      <div class="controls">
        <div class="top-row">
          <div class="now-playing">
            <div class="t" id="trackTitle">—</div>
            <div class="a" id="trackArtist">—</div>
          </div>
          <div class="time-display">
            <span id="curTime">0:00</span> / <span id="durTime">0:00</span>
          </div>
        </div>

        <div class="buffering-line" id="bufferingLine"></div>

        <div class="progress-bar" id="progressBar">
          <div class="progress-fill" id="progressFill"></div>
        </div>

        <div class="buttons-row">
          <div class="transport">
            <button class="btn circle" id="prevBtn" title="Previous">
              <svg viewBox="0 0 24 24"
                ><path d="M17 6l-8 6 8 6V6zm-9 0h2v12H8V6z"></path></svg
              >
            </button>
            <button
              class="btn circle play-pause"
              id="playBtn"
              title="Play/Pause"
            >
              <svg viewBox="0 0 24 24"
                ><path id="playIcon" d="M8 5v14l11-7z"></path></svg
              >
            </button>
            <button class="btn circle" id="nextBtn" title="Next">
              <svg viewBox="0 0 24 24"
                ><path d="M7 6l8 6-8 6V6zm9 0h2v12h-2V6z"></path></svg
              >
            </button>
          </div>

          <div class="volume">
            <input
              type="range"
              id="volumeSlider"
              min="0"
              max="1"
              step="0.01"
              value="1"
              title="Volume"
            />
          </div>
        </div>

        <div class="status-line" id="statusLine"></div>

        <div class="upcoming" id="upcoming">
          <div class="upcoming-heading">Up Next</div>
          <div id="upcomingList"></div>
        </div>
      </div>
    </div>

    <audio id="audio" preload="metadata"></audio>
  </div>
</section>

<script is:inline>
  /* =========================================================================
   VINYL PLAYER WIDGET
   - Loads a playlist from the Jamendo API (free, Creative-Commons catalogue)
   - Swap JAMENDO_CLIENT_ID for your own (https://devportal.jamendo.com)
   ========================================================================= */

  const JAMENDO_CLIENT_ID = "8e1f4e47"; // your Jamendo client_id
  const PLAYLIST_MODE = "tags"; // "tags" | "ids" | "demo"
  const PLAYLIST_TAGS = "chillout";
  const PLAYLIST_TRACK_IDS = [];
  const PLAYLIST_LIMIT = 10;

  // A ready-to-play public playlist (all Creative-Commons tracks from Jamendo's
  // open catalogue) — used instantly on load, and as the fallback if the live
  // API call is blocked (offline, ad-blocker, CORS, sandboxed preview, etc.)
  const DEMO_PLAYLIST = [
    {
      name: "mañana será tarde",
      artist_name: "fankel",
      image:
        "https://usercontent.jamendo.com?type=album&id=368084&width=300&trackid=1848357",
      audio:
        "https://prod-1.storage.jamendo.com/?trackid=1848357&format=mp31&from=app-devsite",
    },
    {
      name: "Scene 5",
      artist_name: "WE ARE FM",
      image:
        "https://usercontent.jamendo.com?type=album&id=104336&width=300&trackid=887209",
      audio:
        "https://prod-1.storage.jamendo.com/?trackid=887209&format=mp31&from=app-devsite",
    },
    {
      name: "Press Record",
      artist_name: "WE ARE FM",
      image:
        "https://usercontent.jamendo.com?type=album&id=104336&width=300&trackid=887202",
      audio:
        "https://prod-1.storage.jamendo.com/?trackid=887202&format=mp31&from=app-devsite",
    },
    {
      name: "Balrog Boogie",
      artist_name: "Diablo Swing Orchestra",
      image:
        "https://usercontent.jamendo.com?type=album&id=49216&width=300&trackid=391002",
      audio:
        "https://prod-1.storage.jamendo.com/?trackid=391002&format=mp31&from=app-devsite",
    },
  ];

  // ---- DOM refs ----
  const art = document.getElementById("art");
  const labelCover = document.getElementById("labelCover");
  const labelTitleText = document.getElementById("labelTitleText");
  const diskRingTextPath = document.getElementById("diskRingTextPath");
  const playGlyphPath = document.getElementById("playGlyphPath");
  const playIcon = document.getElementById("playIcon");
  const playBtn = document.getElementById("playBtn");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const trackTitleEl = document.getElementById("trackTitle");
  const trackArtistEl = document.getElementById("trackArtist");
  const progressBar = document.getElementById("progressBar");
  const progressFill = document.getElementById("progressFill");
  const curTimeEl = document.getElementById("curTime");
  const durTimeEl = document.getElementById("durTime");
  const statusLine = document.getElementById("statusLine");
  const bufferingLine = document.getElementById("bufferingLine");
  const audio = document.getElementById("audio");
  const volumeSlider = document.getElementById("volumeSlider");
  const upcomingList = document.getElementById("upcomingList");

  let playlist = [];
  let currentIndex = 0;
  let isPlaying = false;

  // --- Guards against the "buffering glitch": these three flags stop the
  // title/label from flickering or skipping tracks on transient stall events.
  let isTransitioningTrack = false; // true while we're deliberately loading a new track
  let loadToken = 0; // increments each loadTrack() call; stale async callbacks are ignored
  let errorRetryCount = 0; // retries once before actually skipping a track

  const ICON_PLAY = "M8 5v14l11-7z";
  const ICON_PAUSE = "M6 5h4v14H6zm8 0h4v14h-4z";
  const GLYPH_PLAY = "M-8,-14 L-8,14 L16,0 Z";
  const GLYPH_PAUSE =
    "M-14,-14 L-4,-14 L-4,14 L-14,14 Z M4,-14 L14,-14 L14,14 L4,14 Z";

  function fmtTime(sec) {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60)
      .toString()
      .padStart(2, "0");
    return `${m}:${s}`;
  }

  function setIcons(playing) {
    playIcon.setAttribute("d", playing ? ICON_PAUSE : ICON_PLAY);
    playGlyphPath.setAttribute("d", playing ? GLYPH_PAUSE : GLYPH_PLAY);
  }

  // Truncates long titles so the SVG label text never overflows the disc.
  function fitTitle(name) {
    if (!name) return "Untitled";
    return name.length > 22 ? name.slice(0, 21) + "…" : name;
  }

  function setCoverImage(url) {
    labelCover.classList.remove("loaded");
    if (!url) return;
    // Set both href and xlink:href — some browsers (older Safari, some
    // embedded webviews) only recognise the namespaced xlink:href on SVG
    // <image>, which is why cover art could silently fail to appear before.
    labelCover.setAttribute("href", url);
    labelCover.setAttributeNS("http://www.w3.org/1999/xlink", "href", url);
  }

  function setTitleText(track) {
    // Update all title/artist copies ATOMICALLY, in one go, so the UI never
    // shows a half-updated / stale-then-fresh flicker while buffering.
    labelTitleText.textContent = fitTitle(track.name);
    trackTitleEl.textContent = track.name || "Untitled";
    trackArtistEl.textContent = track.artist_name || "Unknown artist";
    setCoverImage(track.image);
    setDiskRingText(track.name);
  }

  // Repeats "NAME • " enough times to wrap fully around the guide circle
  // (circumference ≈ 2·π·180 ≈ 1131px), so the loop reads seamlessly.
  function setDiskRingText(name) {
    const label = (name || "Untitled").toUpperCase() + " \u2022 ";
    const approxCharWidth = 14; // rough average glyph width at this font-size/letter-spacing
    const circumference = 2 * Math.PI * 180;
    let repeated = "";
    while (repeated.length * approxCharWidth < circumference) {
      repeated += label;
    }
    diskRingTextPath.textContent = repeated;
  }

  labelCover.addEventListener("load", () => labelCover.classList.add("loaded"));
  labelCover.addEventListener("error", () =>
    labelCover.classList.remove("loaded"),
  );

  function renderUpcoming() {
    if (!playlist.length) {
      upcomingList.innerHTML = "";
      return;
    }
    const count = Math.min(3, playlist.length - 1); // never show the currently-playing track
    let html = "";
    for (let i = 1; i <= count; i++) {
      const t = playlist[(currentIndex + i) % playlist.length];
      html += `<div class="upcoming-row">
      <span class="num">${i}</span>
      <div class="info">
        <div class="name">${t.name || "Untitled"}</div>
        <div class="artist">${t.artist_name || "Unknown artist"}</div>
      </div>
    </div>`;
    }
    upcomingList.innerHTML = html;
  }

  function loadTrack(index, autoplay) {
    if (!playlist.length) return;

    currentIndex = (index + playlist.length) % playlist.length;
    const t = playlist[currentIndex];
    renderUpcoming();
    const myToken = ++loadToken; // this load "owns" this token
    isTransitioningTrack = true;
    errorRetryCount = 0;

    // Fade the text out briefly, THEN swap it in one atomic update — this is
    // what removes the "glitchy" mid-buffer flicker of the previous fix.
    trackTitleEl.classList.add("fading");
    bufferingLine.classList.add("show");

    setTimeout(() => {
      if (myToken !== loadToken) return; // a newer track load has since started — ignore this stale one
      setTitleText(t);
      trackTitleEl.classList.remove("fading");
      audio.src = t.audio;
      progressFill.style.width = "0%";
      curTimeEl.textContent = "0:00";
      durTimeEl.textContent = "0:00";
      if (autoplay) play();
    }, 140);
  }

  function play() {
    audio
      .play()
      .then(() => {
        isPlaying = true;
        art.classList.add("spinning");
        setIcons(true);
      })
      .catch((err) => {
        // Surface the real browser error instead of a generic message — this
        // tells us whether it's an autoplay block, a network/CORS failure, or
        // an unsupported source, which are three very different fixes.
        const reason =
          (audio.error && audio.error.message) ||
          err.message ||
          err.name ||
          "unknown error";
        statusLine.textContent = `Couldn't start playback (${reason}). Try clicking again.`;
        console.error("Playback failed:", err, audio.error);
      });
  }

  function pause() {
    audio.pause();
    isPlaying = false;
    art.classList.remove("spinning");
    setIcons(false);
  }

  function togglePlay() {
    if (!playlist.length) return;
    isPlaying ? pause() : play();
  }

  function next() {
    loadTrack(currentIndex + 1, isPlaying);
  }
  function prev() {
    loadTrack(currentIndex - 1, isPlaying);
  }

  // ---- Events ----
  art.addEventListener("click", togglePlay);
  playBtn.addEventListener("click", togglePlay);
  nextBtn.addEventListener("click", next);
  prevBtn.addEventListener("click", prev);

  audio.addEventListener("waiting", () => {
    bufferingLine.classList.add("show");
  });
  audio.addEventListener("playing", () => {
    bufferingLine.classList.remove("show");
    isTransitioningTrack = false;
  });
  audio.addEventListener("canplay", () => {
    bufferingLine.classList.remove("show");
  });

  audio.addEventListener("timeupdate", () => {
    if (audio.duration) {
      progressFill.style.width =
        (audio.currentTime / audio.duration) * 100 + "%";
      curTimeEl.textContent = fmtTime(audio.currentTime);
    }
  });
  audio.addEventListener("loadedmetadata", () => {
    durTimeEl.textContent = fmtTime(audio.duration);
  });
  audio.addEventListener("ended", next);

  // Only skip on a REAL fatal error (not transient stalls while buffering),
  // and retry once before giving up — this was the source of tracks/titles
  // rapidly cycling ("glitching") while a track was still buffering.
  audio.addEventListener("error", () => {
    if (isTransitioningTrack) return; // ignore errors from a load we already abandoned
    const codeNames = {
      1: "aborted",
      2: "network error",
      3: "decode error",
      4: "source not supported",
    };
    const code = audio.error ? audio.error.code : null;
    console.error(
      "Audio element error:",
      code,
      codeNames[code] || "",
      audio.currentSrc,
    );
    if (errorRetryCount < 1) {
      errorRetryCount++;
      audio.load();
      return;
    }
    statusLine.textContent = `This track failed to load (${codeNames[code] || "error"}) — skipping to the next one.`;
    next();
  });

  function setVolumeUI(v) {
    volumeSlider.style.setProperty("--vol", v * 100 + "%");
  }
  volumeSlider.addEventListener("input", () => {
    const v = parseFloat(volumeSlider.value);
    audio.volume = v;
    setVolumeUI(v);
  });
  setVolumeUI(parseFloat(volumeSlider.value));

  progressBar.addEventListener("click", (e) => {
    if (!audio.duration) return;
    const rect = progressBar.getBoundingClientRect();
    const ratio = (e.clientX - rect.left) / rect.width;
    audio.currentTime = ratio * audio.duration;
  });

  // ---- Playlist loading (Jamendo API, with an instant offline-safe demo playlist) ----
  function startWithDemoPlaylist() {
    playlist = DEMO_PLAYLIST;
    loadTrack(0, false);
  }

  async function tryLiveJamendoFetch() {
    if (PLAYLIST_MODE === "demo") return; // demo mode: skip the network call entirely

    try {
      let url;
      if (PLAYLIST_MODE === "ids" && PLAYLIST_TRACK_IDS.length) {
        url = `https://api.jamendo.com/v3.0/tracks/?client_id=${JAMENDO_CLIENT_ID}&format=json&id=${PLAYLIST_TRACK_IDS.join(",")}`;
      } else {
        url = `https://api.jamendo.com/v3.0/tracks/?client_id=${JAMENDO_CLIENT_ID}&format=json&limit=${PLAYLIST_LIMIT}&tags=${encodeURIComponent(PLAYLIST_TAGS)}&include=musicinfo&audioformat=mp32`;
      }

      const res = await fetch(url);
      if (!res.ok) return; // stay on the demo playlist, no visible error
      const data = await res.json();
      if (!data.results || !data.results.length) return;

      const liveTracks = data.results
        .filter((t) => t.audio)
        .map((t) => ({
          name: t.name,
          artist_name: t.artist_name,
          image: t.album_image || t.image,
          audio: t.audio,
        }));

      if (!liveTracks.length) return;

      // Swap in the live playlist quietly. If nothing has played yet, load
      // its first track; otherwise leave the current track playing and just
      // extend the queue.
      playlist = liveTracks;
      if (!isPlaying && audio.currentTime === 0) {
        loadTrack(0, false);
      }
      renderUpcoming();
      statusLine.textContent = "";
    } catch (err) {
      // Network blocked / CORS / offline — this is expected in some sandboxed
      // environments. Silently keep using the demo playlist, no user-facing error.
      console.info("Live Jamendo fetch unavailable, using demo playlist.", err);
    }
  }

  startWithDemoPlaylist();
  tryLiveJamendoFetch();
</script>
