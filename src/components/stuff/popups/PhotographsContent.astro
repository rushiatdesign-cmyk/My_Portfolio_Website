---
// Photographs popup content
// Configuration for the robust Cell-Jitter algorithm
const numPhotos = 50;
const canvasWidth = 1800;
const canvasHeight = 1300;

// Calculate grid dimensions
const cols = Math.ceil(Math.sqrt(numPhotos * (canvasWidth / canvasHeight)));
const rows = Math.ceil(numPhotos / cols);

const cellWidth = canvasWidth / cols;
const cellHeight = canvasHeight / rows;

const photos = Array.from({ length: numPhotos }).map((_, i) => {
  // 1. Assign to a cell
  const col = i % cols;
  const row = Math.floor(i / cols);

  // 2. Find the center of that cell
  const baseLeft = col * cellWidth + cellWidth / 2;
  const baseTop = row * cellHeight + cellHeight / 2;

  // 3. Apply a controlled random jitter (up to 35% of the cell size away from center)
  // This guarantees they look scattered but can never clump or leave massive voids
  const jitterX = (((i * 137) % 100) / 100 - 0.5) * (cellWidth * 0.7);
  const jitterY = (((i * 211) % 100) / 100 - 0.5) * (cellHeight * 0.7);

  // 4. Calculate final position
  const finalLeft = baseLeft + jitterX;
  const finalTop = baseTop + jitterY;

  const scale = 0.6 + (((i * 43) % 100) / 100) * 0.8; // Random scale 0.6 to 1.4
  const rotation = ((i * 17) % 35) - 17; // Random rotation -17 to 17 deg

  return {
    id: i + 1,
    image: `https://picsum.photos/seed/photograph${i}/1200/800`,
    jitter: rotation,
    x: finalLeft.toFixed(2), // Absolute X pixel coordinate
    y: finalTop.toFixed(2), // Absolute Y pixel coordinate
    scale: scale.toFixed(2),
  };
});
const photoUrls = photos.map((p) => p.image);
---

<style>
  /* The popup content area should now act as the container */
  .stuff-popup-content.photos-container {
    padding: 0;
    margin: 0 calc(-1 * clamp(24px, 5vw, 64px))
      calc(-1 * clamp(40px, 6vh, 80px)); /* Pull to edges */
    overflow: hidden; /* Hide scrollbars, JS takes over */
    background: transparent !important; /* Inherits yellow from modal */
  }

  .photos-viewport {
    position: relative;
    width: 100%;
    height: 80vh; /* Fixed height for the parallax viewport to work */
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }

  .photos-viewport.is-dragging {
    cursor: grabbing;
  }

  .photos-track {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--track-width);
    height: var(--track-height);

    will-change: transform;
  }

  .photo-card {
    position: absolute;
    /* Use exact pixel coordinates from the algorithm, centered on the coordinate */
    left: calc(var(--x) * 1px);
    top: calc(var(--y) * 1px);
    /* The transform handles both the centering offset and the rotation */
    transform: translate(-50%, -50%) rotate(calc(var(--jitter) * 1deg));

    width: calc(160px * var(--scale));
    /* Removed aspect-ratio to let the card adopt a Polaroid shape (taller than wide) */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    user-select: none;
    z-index: 1;
    padding: 16px 16px 42px 16px; /* Increased padding to support the thicker border */
    cursor: pointer; /* Affordance for lightbox */

    /* Solid yellow background so cards block the ones behind them when overlapping */
    background-color: #f5c842;
  }

  /* Ink frame mask using blogborder */
  .photo-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #0d1855; /* Blue color */
    pointer-events: none;
    z-index: 2;

    -webkit-mask-box-image-source: url("/images/frame/blogborder.PNG");
    -webkit-mask-box-image-slice: 12%;
    -webkit-mask-box-image-width: 16px; /* Significantly thicker frame */
    -webkit-mask-box-image-repeat: stretch;

    mask-border-source: url("/images/frame/blogborder.PNG");
    mask-border-slice: 12%;
    mask-border-width: 16px; /* Significantly thicker frame */
    mask-border-repeat: stretch;
  }

  /* Hover effect now handled smoothly by GSAP in the script! */

  .photo-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3; /* Force the image area to remain landscape */
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.7);
    transition: box-shadow 0.25s ease;

    /* Using the blog image mask so the photo fits nicely */
    -webkit-mask-image: url("/images/frame/blogimagemask.PNG");
    mask-image: url("/images/frame/blogimagemask.PNG");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .photo-card__image {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    display: block;
    /* Apply the inner parallax variables set by JS */
    transform: translate3d(var(--inner-px, 0px), var(--inner-py, 0px), 0)
      scale(1);
    /* Transition removed so GSAP can take over smoothly on hover, 
       but we keep it for the inner parallax if we want, but better to let GSAP handle scale */
  }

  .photo-card__caption {
    position: absolute;
    bottom: 12px;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 0.8rem;
    font-family: var(--font-display, "Slackey"), cursive;
    color: #111010;
    pointer-events: none;
    z-index: 3;
    opacity: 0.85;
  }

  /* Hint styling */
  .photos-hint {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    margin: 0;
    padding: 8px 16px;
    border: 1px solid rgba(17, 16, 16, 0.25);
    border-radius: 999px;
    font-family: var(--font-display, "Slackey");
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111010;
    background: rgba(245, 200, 66, 0.6);
    backdrop-filter: blur(6px);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.6s ease;
    z-index: 3;
  }

  .photos-hint.is-hidden {
    opacity: 0;
  }

  /* Lightbox Styles */
  .photos-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 24, 85, 0.92); /* Dark blue overlay */
    backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .photos-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .photos-lightbox__content {
    position: relative;
    max-width: 85vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photos-lightbox__image {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .photos-lightbox__image.is-loading {
    opacity: 0;
    transform: scale(0.98);
  }

  .photos-lightbox__btn {
    position: absolute;
    background: none;
    border: none;
    color: #f5c842;
    font-size: 3.5rem;
    font-family: var(--font-display, "Slackey");
    cursor: pointer;
    padding: 20px;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photos-lightbox__btn:hover {
    transform: scale(1.15);
    color: #fff;
  }

  .photos-lightbox__btn:active {
    transform: scale(0.95);
  }

  .photos-lightbox__btn--close {
    top: 20px;
    right: 20px;
    position: fixed;
    font-size: 3rem;
  }

  .photos-lightbox__btn--prev {
    left: 2vw;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
  }
  .photos-lightbox__btn--prev:hover {
    transform: translateY(-50%) scale(1.15);
  }

  .photos-lightbox__btn--next {
    right: 2vw;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
  }
  .photos-lightbox__btn--next:hover {
    transform: translateY(-50%) scale(1.15);
  }

  /* Responsive Track - keep canvas large for dragging, but make cards slightly smaller on mobile */
  @media (max-width: 720px) {
    .photo-card {
      width: clamp(180px, 30vw, 260px);
    }
  }
</style>

<section class="stuff-popup-content photos-container">
  <div class="photos-viewport" id="photos-viewport">
    <div
      class="photos-track"
      id="photos-track"
      data-images={JSON.stringify(photoUrls)}
      style={`--track-width: ${canvasWidth}px; --track-height: ${canvasHeight}px;`}
    >
      {
        photos.map((photo, index) => (
          <div
            class="photo-card"
            data-index={index}
            style={`--jitter: ${photo.jitter}; --x: ${photo.x}; --y: ${photo.y}; --scale: ${photo.scale};`}
          >
            <div class="photo-card__image-wrap">
              <img
                class="photo-card__image"
                src={photo.image}
                alt={`Photograph ${photo.id}`}
                loading="lazy"
                draggable="false"
              />
            </div>
            <div class="photo-card__caption">Photo {photo.id}</div>
          </div>
        ))
      }
    </div>
    <p class="photos-hint" id="photos-hint" aria-hidden="true">
      scroll / drag to move
    </p>
  </div>
</section>

<!-- Lightbox DOM -->
<div
  class="photos-lightbox"
  id="photos-lightbox"
  aria-hidden="true"
  role="dialog"
>
  <button
    class="photos-lightbox__btn photos-lightbox__btn--close"
    id="lightbox-close"
    aria-label="Close Lightbox">×</button
  >
  <button
    class="photos-lightbox__btn photos-lightbox__btn--prev"
    id="lightbox-prev"
    aria-label="Previous Photo">‹</button
  >
  <div class="photos-lightbox__content" id="lightbox-backdrop">
    <img
      class="photos-lightbox__image"
      id="lightbox-image"
      src=""
      alt="Full size photograph"
    />
  </div>
  <button
    class="photos-lightbox__btn photos-lightbox__btn--next"
    id="lightbox-next"
    aria-label="Next Photo">›</button
  >
</div>

<script>
  // @ts-nocheck
  import gsap from "gsap";
  // Vanilla drag + momentum + edge bounce-back for the photographs canvas.

  function lockPageScroll() {
    document.body.style.overflow = "hidden";
    document.body.style.touchAction = "none";
  }

  function unlockPageScroll() {
    document.body.style.overflow = "";
    document.body.style.touchAction = "";
  }

  function initPhotosCanvas() {
    const viewport = document.getElementById("photos-viewport");
    const track = document.getElementById("photos-track");
    const hint = document.getElementById("photos-hint");
    if (!viewport || !track) return;

    if (viewport.dataset.initialized === "true") return;
    viewport.dataset.initialized = "true";

    const V = viewport;
    const T = track;
    const H = hint;

    // Start x and y will be set later to center the track
    let x = 0;
    let y = 0;
    let parallaxX = 0;
    let parallaxY = 0;
    let targetParallaxX = 0;
    let targetParallaxY = 0;
    let parallaxFrame = null;
    let pointerX = 0;
    let pointerY = 0;
    let autoPanVX = 0;
    let autoPanVY = 0;
    let autoPanFrame = null;
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let lastMoveX = 0;
    let lastMoveY = 0;
    let lastMoveTime = 0;
    let isDragging = false;
    let isClicking = false; // To distinguish between drag and click
    let clickTarget = null; // Save original target before pointer capture
    let momentumFrame = null;
    let hasInteracted = false;

    const FRICTION = 0.94;
    const BOUNCE_DURATION = 400;
    const PARALLAX_MAX = 28;
    const PARALLAX_SMOOTH = 0.14;
    const EDGE_ZONE = 96;
    const EDGE_PAN_MAX = 12;

    function getBounds() {
      const trackRect = T.getBoundingClientRect();
      const viewportRect = V.getBoundingClientRect();
      const trackWidth = T.scrollWidth;
      const trackHeight = T.scrollHeight;
      const minX = Math.min(0, viewportRect.width - trackWidth);
      const minY = Math.min(0, viewportRect.height - trackHeight);
      return { minX, maxX: 0, minY, maxY: 0 };
    }

    function setTransform(px, py) {
      T.style.transform = `translate3d(${px + parallaxX}px, ${py + parallaxY}px, 0)`;
    }

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function dismissHint() {
      if (hasInteracted || !H) return;
      hasInteracted = true;
      H.classList.add("is-hidden");
    }

    function stopMomentum() {
      if (momentumFrame !== null) {
        cancelAnimationFrame(momentumFrame);
        momentumFrame = null;
      }
    }

    function animateParallax() {
      parallaxX += (targetParallaxX - parallaxX) * PARALLAX_SMOOTH;
      parallaxY += (targetParallaxY - parallaxY) * PARALLAX_SMOOTH;
      setTransform(x, y);

      // Update inner image parallax (moves opposite to the track)
      V.style.setProperty("--inner-px", `${-parallaxX * 0.9}px`);
      V.style.setProperty("--inner-py", `${-parallaxY * 0.9}px`);

      if (
        Math.abs(targetParallaxX - parallaxX) > 0.05 ||
        Math.abs(targetParallaxY - parallaxY) > 0.05
      ) {
        parallaxFrame = requestAnimationFrame(animateParallax);
      } else {
        parallaxFrame = null;
      }
    }

    function animateAutoPan() {
      x = x + autoPanVX;
      y = y + autoPanVY;
      const bounds = getBounds();
      x = clamp(x, bounds.minX - 60, bounds.maxX + 60);
      y = clamp(y, bounds.minY - 60, bounds.maxY + 60);
      setTransform(x, y);
      if (Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) {
        autoPanFrame = requestAnimationFrame(animateAutoPan);
      } else {
        autoPanFrame = null;
      }
    }

    function settleToBounds() {
      const bounds = getBounds();
      const targetX = clamp(x, bounds.minX, bounds.maxX);
      const targetY = clamp(y, bounds.minY, bounds.maxY);
      if (targetX !== x || targetY !== y) {
        T.style.transition = `transform ${BOUNCE_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        x = targetX;
        y = targetY;
        setTransform(x, y);
        window.setTimeout(() => {
          T.style.transition = "none";
        }, BOUNCE_DURATION);
      }
    }

    function runMomentum() {
      const bounds = getBounds();

      if (x > bounds.maxX) velocityX -= (x - bounds.maxX) * 0.12;
      if (x < bounds.minX) velocityX -= (x - bounds.minX) * 0.12;
      if (y > bounds.maxY) velocityY -= (y - bounds.maxY) * 0.12;
      if (y < bounds.minY) velocityY -= (y - bounds.minY) * 0.12;

      velocityX *= FRICTION;
      velocityY *= FRICTION;
      x += velocityX;
      y += velocityY;
      setTransform(x, y);

      if (Math.abs(velocityX) > 0.3 || Math.abs(velocityY) > 0.3) {
        momentumFrame = requestAnimationFrame(runMomentum);
      } else {
        momentumFrame = null;
        settleToBounds();
      }
    }

    function onPointerDown(e) {
      // Don't drag if lightbox is open
      if (
        document.getElementById("photos-lightbox").classList.contains("is-open")
      )
        return;

      clickTarget = e.target;
      dismissHint();
      stopMomentum();
      T.style.transition = "none";
      isDragging = true;
      isClicking = true; // Assume it's a click until they move far enough
      V.classList.add("is-dragging");
      startX = e.clientX;
      startY = e.clientY;
      originX = x;
      originY = y;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = performance.now();
      velocityX = 0;
      velocityY = 0;
      V.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e) {
      if (!isDragging) {
        if (e.pointerType === "mouse") {
          const rect = V.getBoundingClientRect();
          const nx =
            (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const ny =
            (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
          targetParallaxX = clamp(
            -nx * PARALLAX_MAX,
            -PARALLAX_MAX,
            PARALLAX_MAX,
          );
          targetParallaxY = clamp(
            -ny * (PARALLAX_MAX * 0.6),
            -PARALLAX_MAX,
            PARALLAX_MAX,
          );
          pointerX = e.clientX - rect.left;
          pointerY = e.clientY - rect.top;
          const zone = EDGE_ZONE;
          autoPanVX = 0;
          autoPanVY = 0;
          if (pointerX < zone) {
            autoPanVX = ((zone - pointerX) / zone) * EDGE_PAN_MAX;
          } else if (pointerX > rect.width - zone) {
            autoPanVX =
              -((pointerX - (rect.width - zone)) / zone) * EDGE_PAN_MAX;
          }
          if (pointerY < zone) {
            autoPanVY = ((zone - pointerY) / zone) * (EDGE_PAN_MAX * 0.45);
          } else if (pointerY > rect.height - zone) {
            autoPanVY =
              -((pointerY - (rect.height - zone)) / zone) *
              (EDGE_PAN_MAX * 0.45);
          }
          if (parallaxFrame === null)
            parallaxFrame = requestAnimationFrame(animateParallax);
          if (
            (Math.abs(autoPanVX) > 0.01 || Math.abs(autoPanVY) > 0.01) &&
            autoPanFrame === null
          ) {
            autoPanFrame = requestAnimationFrame(animateAutoPan);
          }
        }
        return;
      }

      // If they move more than 10px, it's a drag, not a click
      if (
        Math.abs(e.clientX - startX) > 10 ||
        Math.abs(e.clientY - startY) > 10
      ) {
        isClicking = false;
      }

      const bounds = getBounds();

      let nextX = originX + (e.clientX - startX);
      let nextY = originY + (e.clientY - startY);

      if (nextX > bounds.maxX)
        nextX = bounds.maxX + (nextX - bounds.maxX) * 0.35;
      if (nextX < bounds.minX)
        nextX = bounds.minX + (nextX - bounds.minX) * 0.35;
      if (nextY > bounds.maxY)
        nextY = bounds.maxY + (nextY - bounds.maxY) * 0.35;
      if (nextY < bounds.minY)
        nextY = bounds.minY + (nextY - bounds.minY) * 0.35;

      x = nextX;
      y = nextY;
      setTransform(x, y);

      const now = performance.now();
      const dt = Math.max(now - lastMoveTime, 1);
      velocityX = ((e.clientX - lastMoveX) / dt) * 16;
      velocityY = ((e.clientY - lastMoveY) / dt) * 16;
      lastMoveX = e.clientX;
      lastMoveY = e.clientY;
      lastMoveTime = now;
    }

    function onPointerUp(e) {
      if (!isDragging) return;
      isDragging = false;
      V.classList.remove("is-dragging");
      V.releasePointerCapture(e.pointerId);

      // Open Lightbox if it was a valid click on a card
      if (isClicking && clickTarget) {
        // Because of the inner wrapper, we find the closest photo-card
        let card = clickTarget;
        while (card && !card.classList?.contains("photo-card")) {
          card = card.parentElement;
        }
        if (card) {
          const indexStr = card.getAttribute("data-index");
          if (indexStr) {
            openLightbox(parseInt(indexStr, 10));
          }
        }
      }

      clickTarget = null;
      momentumFrame = requestAnimationFrame(runMomentum);
      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    }

    function onWheel(e) {
      // Prevent default to stop scrolling the page while inside the canvas
      e.preventDefault();
      e.stopPropagation();

      dismissHint();
      stopMomentum();
      T.style.transition = "none";

      const bounds = getBounds();
      x = clamp(x - e.deltaX, bounds.minX - 60, bounds.maxX + 60);
      y = clamp(y - e.deltaY, bounds.minY - 60, bounds.maxY + 60);
      setTransform(x, y);

      velocityX = -e.deltaX * 0.5;
      velocityY = -e.deltaY * 0.5;
      stopMomentum();
      momentumFrame = requestAnimationFrame(runMomentum);
      targetParallaxX = clamp(-e.deltaX * 0.02, -PARALLAX_MAX, PARALLAX_MAX);
      targetParallaxY = clamp(-e.deltaY * 0.015, -PARALLAX_MAX, PARALLAX_MAX);
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    }

    V.addEventListener("pointerdown", onPointerDown);
    V.addEventListener("pointermove", onPointerMove);
    V.addEventListener("pointerup", onPointerUp);
    V.addEventListener("pointercancel", onPointerUp);
    V.addEventListener("wheel", onWheel, { passive: false });
    V.addEventListener("pointerleave", () => {
      targetParallaxX = 0;
      targetParallaxY = 0;
      if (parallaxFrame === null)
        parallaxFrame = requestAnimationFrame(animateParallax);
    });

    V.addEventListener("dragstart", (e) => e.preventDefault());

    // Robust Modal Scroll Lock to completely isolate interactions
    const overlay = V.closest(".stuff-modal-overlay");
    if (overlay) {
      let isPageLocked = false;
      let savedScrollY = 0;
      let originalStyles = {
        position: "",
        top: "",
        left: "",
        right: "",
        width: "",
      };

      function lockPageScroll() {
        if (isPageLocked) return;
        isPageLocked = true;
        savedScrollY = window.scrollY;

        // Save original styles
        originalStyles.position = document.body.style.position;
        originalStyles.top = document.body.style.top;
        originalStyles.left = document.body.style.left;
        originalStyles.right = document.body.style.right;
        originalStyles.width = document.body.style.width;

        // Lock the page exactly where it is
        document.body.style.position = "fixed";
        document.body.style.top = `-${savedScrollY}px`;
        document.body.style.left = "0";
        document.body.style.right = "0";
        document.body.style.width = "100%";
        document.documentElement.classList.add("photos-modal-lock");
      }

      function unlockPageScroll() {
        if (!isPageLocked) return;
        isPageLocked = false;

        // Restore previous styles
        document.body.style.position = originalStyles.position;
        document.body.style.top = originalStyles.top;
        document.body.style.left = originalStyles.left;
        document.body.style.right = originalStyles.right;
        document.body.style.width = originalStyles.width;
        document.documentElement.classList.remove("photos-modal-lock");

        // Restore scroll position
        window.scrollTo(0, savedScrollY);
      }

      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.attributeName === "aria-hidden") {
            if (overlay.getAttribute("aria-hidden") === "false") {
              lockPageScroll();
            } else {
              unlockPageScroll();
            }
          }
        }
      });
      observer.observe(overlay, { attributes: true });

      // Initial check in case it's already open
      if (overlay.getAttribute("aria-hidden") === "false") {
        lockPageScroll();
      }
    }

    // Center the canvas on load instead of starting at top-left (0,0)
    // We delay slightly to ensure DOM dimensions are computed before bounding
    setTimeout(() => {
      const bounds = getBounds();
      x = bounds.minX / 2;
      y = bounds.minY / 2;
      setTransform(x, y);
    }, 10);

    // ==========================================
    // Lightbox Logic
    // ==========================================
    const lightbox = document.getElementById("photos-lightbox");
    const lbImage = document.getElementById("lightbox-image");
    const btnClose = document.getElementById("lightbox-close");
    const btnPrev = document.getElementById("lightbox-prev");
    const btnNext = document.getElementById("lightbox-next");
    const imagesDataStr = T.getAttribute("data-images");
    const urls = imagesDataStr ? JSON.parse(imagesDataStr) : [];

    let currentIndex = 0;
    let isLightboxOpen = false;

    function openLightbox(index) {
      if (urls.length === 0 || !lightbox || !lbImage) return;
      currentIndex = index;
      isLightboxOpen = true;
      lightbox.classList.add("is-open");
      updateLightboxImage();
      document.addEventListener("keydown", onLightboxKeydown);
    }

    function closeLightbox() {
      if (!lightbox) return;
      isLightboxOpen = false;
      lightbox.classList.remove("is-open");
      document.removeEventListener("keydown", onLightboxKeydown);
    }

    function updateLightboxImage() {
      if (!lbImage) return;
      lbImage.classList.add("is-loading");

      // Load new image
      const newImg = new Image();
      newImg.src = urls[currentIndex];
      newImg.onload = () => {
        lbImage.src = newImg.src;
        lbImage.classList.remove("is-loading");
      };
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % urls.length;
      updateLightboxImage();
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + urls.length) % urls.length;
      updateLightboxImage();
    }

    function onLightboxKeydown(e) {
      if (!isLightboxOpen) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") nextImage();
      if (e.key === "ArrowLeft") prevImage();
    }

    if (lightbox) {
      btnClose?.addEventListener("click", closeLightbox);
      btnNext?.addEventListener("click", nextImage);
      btnPrev?.addEventListener("click", prevImage);

      // Close on backdrop click
      lightbox.addEventListener("click", (e) => {
        if (
          e.target === lightbox ||
          e.target === document.getElementById("lightbox-backdrop")
        ) {
          closeLightbox();
        }
      });
    }

    // ==========================================
    // Smooth GSAP Hover Effects
    // ==========================================
    const cards = document.querySelectorAll(".photo-card");
    cards.forEach((card) => {
      const jitter = parseFloat(card.style.getPropertyValue("--jitter") || "0");
      const img = card.querySelector(".photo-card__image");

      // Initialize GSAP to replace the static CSS transform
      gsap.set(card, {
        xPercent: -50,
        yPercent: -50,
        rotation: jitter,
        scale: 1,
      });

      card.addEventListener("mouseenter", () => {
        gsap.to(card, {
          scale: 1.06,
          rotation: 0,
          yPercent: -52, // slight lift
          zIndex: 10,
          duration: 0.6,
          ease: "power3.out",
        });
        if (img) {
          gsap.to(img, {
            scale: 1.08,
            duration: 0.6,
            ease: "power3.out",
          });
        }
      });

      card.addEventListener("mouseleave", () => {
        gsap.to(card, {
          scale: 1,
          rotation: jitter,
          yPercent: -50,
          zIndex: 1,
          duration: 0.8,
          ease: "power3.out",
        });
        if (img) {
          gsap.to(img, {
            scale: 1,
            duration: 0.8,
            ease: "power3.out",
          });
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPhotosCanvas);
  } else {
    initPhotosCanvas();
  }
</script>
