---
// Photographs popup content - GSAP Vertical Scroll Edition
const numPhotos = 12;
const staggers = [
  "-24vw", "14vw", "-18vw", "22vw", "-26vw", "28vw", "-20vw", "8vw", "-12vw", "15vw", "-24vw", "26vw"
];
const widths = [
  "290px", "330px", "270px", "450px", "300px", "150px", "230px", "460px", "270px", "250px", "390px", "160px"
];

const photos = Array.from({ length: numPhotos }).map((_, i) => {
  return {
    id: i + 1,
    image: `https://picsum.photos/seed/photograph${i}/1200/800`,
    caption: `Photograph ${i + 1}`,
  };
});
---

<section class="stuff-popup-content photos-container">
  <div class="gallery">
    {photos.map((item, idx) => (
      <figure class="gallery__slide" style={`--stagger: ${staggers[idx % staggers.length]}; --img-w: ${widths[idx % widths.length]};`}>
        <div class="gallery__img-wrapper">
          <img
            class="gallery__img"
            src={item.image}
            alt={item.caption}
            loading="eager"
          />
        </div>
        <figcaption>{item.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="content">
    <div class="content-wrapper">
      <figure class="content__preview-img">
        <img alt="" />
      </figure>
      <div class="content__group-list">
        <button class="content__back" type="button">&larr; back [ESC]</button>
        {photos.map((item, idx) => (
          <div class="content__group" data-index={idx}>
            <div class="content__title">{item.caption}</div>
            <div class="content__description">
              A detailed description for {item.caption} goes here. This represents the content associated with the photograph.
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Base Container */
  .photos-container {
    padding: 0;
    margin: 0 calc(-1 * clamp(24px, 5vw, 64px)) calc(-1 * clamp(40px, 6vh, 80px)); /* Pull to edges */
    height: 84vh;
    overflow: hidden; /* Hide scrollbars, JS takes over */
    background: transparent !important;
    position: relative;
    /* Use the font styles from the reference */
    --color-text: #0D1855;
    --color-bg: #F5C842;
    --color-link: #0D1855;
    --color-link-hover: #ffffff;
    --color-desc: #0D1855;
    --page-padding: 1.5rem;
  }

  /* Gallery */
  .gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12vh;
    width: 100%;
    padding-top: 14vh;
  }

  .gallery__slide {
    flex-shrink: 0;
    transform: translateX(var(--stagger, 0vw));
    cursor: pointer;
    outline: none;
    
    /* INK FRAME LOGIC */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 16px 16px 42px 16px;
    background-color: #F5C842;
  }

  .gallery__slide::after {
    content: "";
    position: absolute;
    inset: -30px;
    z-index: 10;
    pointer-events: none;
    -webkit-mask-box-image: url("/images/blogborder.PNG") 100 100 100 100 round;
    mask-border: url("/images/blogborder.PNG") 100 100 100 100 round;
    -webkit-mask-box-image-width: 32px;
    mask-border-width: 32px;
    background-color: #0D1855;
  }

  .gallery__slide figcaption {
    display: block;
    margin-top: 1.5rem;
    color: var(--color-desc);
    font-family: var(--font-display, "Slackey"), cursive;
    font-size: 1.2rem;
    z-index: 2;
  }

  .gallery__img-wrapper {
    position: relative;
    margin: 0;
    width: var(--img-w, 200px);
    height: auto;
    aspect-ratio: 0.8;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  .gallery__img-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
  }

  /**
   * Content: Fixed popup overlay
   */
  .content {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1000;
    background: #F5C842; /* Full background when open */
  }

  /**
   * Content: Clicked image lands here
   */
  .content__preview-img {
    position: absolute;
    margin: 0;
    top: 0;
    left: 0;
    height: 100%;
    aspect-ratio: 0.8;
    overflow: hidden;
    z-index: 2;
    padding: 16px 16px 42px 16px; /* Ink frame padding */
    background-color: #F5C842;
  }

  .content__preview-img::after {
    content: "";
    position: absolute;
    inset: -30px;
    z-index: 10;
    pointer-events: none;
    -webkit-mask-box-image: url("/images/blogborder.PNG") 100 100 100 100 round;
    mask-border: url("/images/blogborder.PNG") 100 100 100 100 round;
    -webkit-mask-box-image-width: 32px;
    mask-border-width: 32px;
    background-color: #0D1855;
  }

  .content__preview-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
  }

  .content__group-list {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-left: calc(80vh + 5vw); /* Provide space for the image */
    padding-right: var(--page-padding);
    padding-top: var(--page-padding);
    padding-bottom: var(--page-padding);
  }

  .content__back {
    font-family: var(--font-display, "Slackey"), cursive;
    font-size: 1.5rem;
    align-self: flex-start;
    border: none;
    background: none;
    color: #0D1855;
    cursor: pointer;
    padding: 0;
    margin-bottom: 2rem;
    transition: transform 0.2s ease;
  }
  
  .content__back:hover {
    transform: scale(1.05);
  }

  .content__group {
    display: none;
  }

  .content__group.active {
    display: block;
  }

  .content__title {
    font-family: var(--font-display, "Slackey"), cursive;
    font-weight: 400;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
    margin-bottom: 2rem;
    margin-top: 10vh;
    color: #0D1855;
  }

  .content__description {
    max-width: 50ch;
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: #0D1855;
    line-height: 1.5;
  }
</style>

<script>
  import imagesLoaded from "imagesloaded";
  import Reveal from "./verticalscroll/Reveal.js";
  import Slider from "./verticalscroll/Slider.js";
  import Transition from "./verticalscroll/Transition.js";

  function initPhotosVertical() {
    const container = document.querySelector(".photos-container");
    if (!container) return;
    
    // Check if initialized
    if (container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    imagesLoaded(container, () => {
      // Image-to-content transition; hands the gallery back when it is done
      const transition = new Transition({ onClose: () => slider.start() });

      // Slide reveals
      const reveal = new Reveal();

      // Infinite slider
      const slider = new Slider({
        enabled: () => transition.state === "closed",
        onToggle: (changes) => reveal.toggle(changes),
      });

      // Gallery slides
      const slides = [...document.querySelectorAll(".gallery__slide")];

      slides.forEach((slide, index) => {
        slide.setAttribute("tabindex", "0");
        slide.setAttribute("role", "button");

        // Only give up the gallery if the transition is going to hand it back
        const open = () => {
          if (transition.state !== "closed") return;

          slider.stop();
          transition.open(slide, index);
        };

        slide.addEventListener("click", open);

        slide.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open();
          }
        });
      });

      document.querySelector(".content__back").addEventListener("click", () => transition.close());

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") transition.close();
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPhotosVertical);
  } else {
    initPhotosVertical();
  }
</script>
