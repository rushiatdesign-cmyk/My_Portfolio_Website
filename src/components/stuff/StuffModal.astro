---
export interface Props {
  /** Unique id used to open this modal via data-modal="id" */
  id: string;
  /** Border and outline color. Defaults to gold. */
  borderColor?: string;
  /** Background color of the modal. Defaults to dark blue. */
  bgColor?: string;
  /** Background color of the close button. Defaults to transparent. */
  closeBtnBg?: string;
  /** Color of the close icon (using CSS mask). Defaults to gold. */
  closeIconColor?: string;
  /** Path to the close icon image */
  closeIcon?: string;
  /** Whether the modal should take up the full screen. Defaults to false. */
  fullscreen?: boolean;
}

const {
  id,
  borderColor = "#F5C842",
  bgColor = "#0D1855",
  closeBtnBg = "transparent",
  closeIconColor = "#F5C842",
  closeIcon = "/images/frame/closeo.PNG",
  fullscreen = false,
} = Astro.props;
---

<div id={id} class={`stuff-modal-overlay ${fullscreen ? 'is-fullscreen' : ''}`} aria-hidden="true" data-stuff-modal>
  <div
    class="stuff-modal-panel"
    role="dialog"
    aria-modal="true"
    style={`border-color: ${borderColor}; outline-color: ${borderColor}; background-color: ${bgColor};`}
  >
    <!-- Sticky close wrapper with zero height so it doesn't push content down -->
    <div class="stuff-modal-close-wrapper">
      <button
        class="stuff-modal-close"
        aria-label="Close"
        data-stuff-close
        style={`background-color: ${closeBtnBg};`}
      >
      <div
        style={`
        width: 32px;
        height: 32px;
        background-color: ${closeIconColor};
        mask: url('${closeIcon}') no-repeat center / contain;
        -webkit-mask: url('${closeIcon}') no-repeat center / contain;
      `}
      >
      </div>
    </button>
    </div>

    <!-- Popup body content (injected per-card via slot) -->
    <div class="stuff-modal-body">
      <slot />
    </div>
  </div>
</div>
