---
export interface Props {
  /** Unique id used to open this modal via data-modal="id" */
  id: string;
  /** Border and outline color. Defaults to gold. */
  borderColor?: string;
  /** Background color of the modal. Defaults to dark blue. */
  bgColor?: string;
  /** Background color of the close button. Defaults to dark blue. */
  closeBtnBg?: string;
  /** Path to the close icon image */
  closeIcon?: string;
}

const {
  id,
  borderColor = "#F5C842",
  bgColor = "#0D1855",
  closeBtnBg = "#0D1855",
  closeIcon = "/images/frame/closeo.PNG",
} = Astro.props;
---

<div
  id={id}
  class="stuff-modal-overlay"
  aria-hidden="true"
  data-stuff-modal
>
  <div
    class="stuff-modal-panel"
    role="dialog"
    aria-modal="true"
    style={`border-color: ${borderColor}; outline-color: ${borderColor}; background-color: ${bgColor};`}
  >
    <!-- Sticky close bar -->
    <button
      class="stuff-modal-close"
      aria-label="Close"
      data-stuff-close
      style={`background-color: ${closeBtnBg};`}
    >
      <img src={closeIcon} alt="Close" />
    </button>

    <!-- Popup body content (injected per-card via slot) -->
    <div class="stuff-modal-body">
      <slot />
    </div>
  </div>
</div>
