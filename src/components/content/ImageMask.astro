---
/**
 * ImageMask.astro
 * Image with swappable CSS clip-path / mask shape.
 *
 * Variants:
 *   rect    — simple rectangle (no clip)
 *   blob    — organic amoeba shape
 *   paper   — slightly irregular paper-torn shape
 *   ticket  — ticket stub shape with notch on one side
 */

export type MaskVariant = 'rect' | 'blob' | 'paper' | 'ticket';

export interface Props {
  src: string;
  alt: string;
  variant?: MaskVariant;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  variant = 'rect',
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

<div class={`image-mask image-mask--${variant} ${className}`}>
  <img src={src} alt={alt} loading={loading} decoding="async" />
</div>

<style>
  .image-mask {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1;
  }

  .image-mask img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Lift image slightly on card hover */
  .image-mask:hover img {
    transform: scale(1.04);
  }

  /* ===========================
     RECT — plain square
  =========================== */
  .image-mask--rect {
    border-radius: 0;
  }

  /* ===========================
     BLOB — organic CSS shape
  =========================== */
  .image-mask--blob {
    clip-path: polygon(
      50% 0%, 85% 10%, 100% 40%,
      90% 75%, 65% 100%, 30% 95%,
      5%  80%, 0%  45%, 15% 15%
    );
  }

  /* ===========================
     PAPER — hand-cut feel
  =========================== */
  .image-mask--paper {
    clip-path: polygon(
      2% 0%, 98% 1%, 100% 3%,
      99% 97%, 97% 100%, 3% 99%,
      0% 97%, 1% 2%
    );
  }

  /* ===========================
     TICKET — stub with half-circle notch cut from right
  =========================== */
  .image-mask--ticket {
    clip-path: path(
      'M 0 0 L 320 0 Q 340 50 320 100 L 340 100 L 340 280 L 320 280 Q 340 330 320 380 L 0 380 Z'
    );
  }
</style>
