---
/**
 * ExpandButton.astro
 * The expand trigger on each card.
 * Emits a data-expand-post + data-content-type attribute that
 * content-modal.js listens to — no inline handlers.
 */

export interface Props {
  postId: string;
  contentType: string;
  label?: string;
}

const {
  postId,
  contentType,
  label = 'Read more',
} = Astro.props;
---

<button
  class="expand-btn"
  type="button"
  aria-label={`Expand: ${label}`}
  data-expand-post={postId}
  data-content-type={contentType}
>
  <!-- Expand / arrows-out icon -->
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round"
       stroke-linejoin="round" aria-hidden="true">
    <polyline points="15 3 21 3 21 9" />
    <polyline points="9 21 3 21 3 15" />
    <line x1="21" y1="3" x2="14" y2="10" />
    <line x1="3" y1="21" x2="10" y2="14" />
  </svg>
  <span class="expand-btn__label">{label}</span>
</button>

<style>
  .expand-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 2px solid var(--cs-border-color, #1d1d1d);
    background: transparent;
    padding: 5px 10px;
    font-size: 11px;
    font-family: var(--cs-font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
    color: inherit;
  }

  .expand-btn:hover {
    background: var(--cs-border-color, #1d1d1d);
    color: var(--cs-card-bg, #fff);
  }

  .expand-btn:focus-visible {
    outline: 3px solid var(--cs-focus-color, #1d1d1d);
    outline-offset: 2px;
  }

  .expand-btn svg {
    flex-shrink: 0;
  }
</style>
