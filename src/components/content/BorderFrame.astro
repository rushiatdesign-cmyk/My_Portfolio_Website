---
/**
 * BorderFrame.astro
 * Decorative border that wraps card content.
 * The card never knows how this is built — swap variants freely.
 *
 * Variants:
 *   paper  — double-rule frame, slightly rotated inner rule
 *   ink    — thick irregular SVG drawn border
 *   stamp  — perforated stamp edge
 *   torn   — rough torn-paper bottom edge
 */

export type BorderVariant = 'paper' | 'ink' | 'stamp' | 'torn';

export interface Props {
  variant?: BorderVariant;
  class?: string;
}

const { variant = 'paper', class: className = '' } = Astro.props;
---

<div class={`border-frame border-frame--${variant} ${className}`}>
  {variant === 'ink' && (
    <svg class="border-frame__ink-svg" viewBox="0 0 400 560" fill="none"
         xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="4" y="4" width="392" height="552" rx="2"
            stroke="#1d1d1d" stroke-width="3"
            stroke-dasharray="6 2" />
      <rect x="10" y="10" width="380" height="540" rx="1"
            stroke="#1d1d1d" stroke-width="1.5" />
    </svg>
  )}

  {variant === 'stamp' && (
    <svg class="border-frame__stamp-svg" viewBox="0 0 400 560" fill="none"
         xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Perforated top -->
      {Array.from({ length: 18 }, (_, i) => (
        <circle cx={22 + i * 21} cy="10" r="6" fill="#fff" />
      ))}
      <!-- Perforated bottom -->
      {Array.from({ length: 18 }, (_, i) => (
        <circle cx={22 + i * 21} cy="550" r="6" fill="#fff" />
      ))}
      <!-- Perforated left -->
      {Array.from({ length: 25 }, (_, i) => (
        <circle cx="10" cy={22 + i * 21} r="6" fill="#fff" />
      ))}
      <!-- Perforated right -->
      {Array.from({ length: 25 }, (_, i) => (
        <circle cx="390" cy={22 + i * 21} r="6" fill="#fff" />
      ))}
    </svg>
  )}

  <slot />
</div>

<style>
  /* ===========================
     BASE
  =========================== */
  .border-frame {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ===========================
     PAPER variant
     Two nested rules — outer solid, inner dashed, 1px gap
  =========================== */
  .border-frame--paper {
    outline: 2px solid var(--cs-border-color, #1d1d1d);
    outline-offset: -2px;
  }
  .border-frame--paper::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px dashed var(--cs-border-color, #1d1d1d);
    opacity: 0.45;
    pointer-events: none;
  }

  /* ===========================
     INK variant
     SVG drawn dashed rect sits on top
  =========================== */
  .border-frame--ink {
    border: none;
  }
  .border-frame__ink-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  /* ===========================
     STAMP variant
     Perforated SVG edge + solid fill border
  =========================== */
  .border-frame--stamp {
    border: 2px solid var(--cs-border-color, #1d1d1d);
  }
  .border-frame__stamp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  /* ===========================
     TORN variant
     Irregular clip-path on the bottom edge
  =========================== */
  .border-frame--torn {
    border: 2px solid var(--cs-border-color, #1d1d1d);
    border-bottom: none;
    clip-path: polygon(
      0% 0%, 100% 0%, 100% 92%,
      95% 96%, 88% 93%, 80% 97%, 72% 94%,
      65% 98%, 57% 95%, 48% 100%, 40% 96%,
      32% 99%, 24% 95%, 16% 98%, 8% 94%,
      0% 97%
    );
  }
</style>
