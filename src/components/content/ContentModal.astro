---
/**
 * ContentModal.astro
 * Single fullscreen modal for expanded content.
 * Rendered empty on the server — JavaScript populates it at runtime
 * from a post registry injected by each page.
 *
 * Features:
 *   - Reading progress bar
 *   - Prev / Next keyboard + button navigation
 *   - Copy link + Share placeholders
 *   - Close: button, Esc, backdrop click
 *   - Body scroll lock
 *   - Backdrop blur
 */
import ContentMeta from './ContentMeta.astro';
---

<!-- Modal is hidden until JS opens it -->
<div
  id="content-modal-overlay"
  class="cm-overlay"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="cm-title"
>
  <!-- Backdrop (click-to-close) -->
  <div class="cm-backdrop" id="cm-backdrop" aria-hidden="true"></div>

  <!-- Panel -->
  <div class="cm-panel" id="cm-panel">

    <!-- Reading progress bar -->
    <div class="cm-progress" id="cm-progress" role="progressbar"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="cm-progress__bar" id="cm-progress-bar"></div>
    </div>

    <!-- Top bar -->
    <header class="cm-topbar">
      <div class="cm-topbar__nav">
        <button class="cm-nav-btn" id="cm-prev-btn" type="button"
                aria-label="Previous post" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          <span>Prev</span>
        </button>
        <button class="cm-nav-btn" id="cm-next-btn" type="button"
                aria-label="Next post" disabled>
          <span>Next</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>

      <div class="cm-topbar__actions">
        <!-- Copy link placeholder -->
        <button class="cm-action-btn" id="cm-copy-btn" type="button"
                aria-label="Copy link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span id="cm-copy-label">Copy link</span>
        </button>

        <!-- Share placeholder -->
        <button class="cm-action-btn" id="cm-share-btn" type="button"
                aria-label="Share">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          <span>Share</span>
        </button>

        <!-- Close -->
        <button class="cm-close-btn" id="cm-close-btn" type="button"
                aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Scrollable body -->
    <div class="cm-scroll" id="cm-scroll">

      <!-- Hero image -->
      <div class="cm-hero" id="cm-hero">
        <img id="cm-hero-img" src="" alt="" loading="eager" />
      </div>

      <!-- Article header -->
      <div class="cm-article-header">
        <h1 id="cm-title" class="cm-title"><!-- JS --></h1>
        <div id="cm-meta-slot" class="cm-meta-slot"><!-- JS --></div>
      </div>

      <!-- Body content -->
      <div id="cm-body" class="cm-body prose">
        <!-- JS populates this from post.body rendered as HTML -->
      </div>

      <!-- Bottom nav -->
      <nav class="cm-bottom-nav" aria-label="Post navigation">
        <button class="cm-bottom-nav__btn" id="cm-bottom-prev" type="button"
                aria-label="Previous post" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          <span id="cm-prev-title">Previous</span>
        </button>
        <button class="cm-bottom-nav__btn cm-bottom-nav__btn--next" id="cm-bottom-next" type="button"
                aria-label="Next post" disabled>
          <span id="cm-next-title">Next</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </nav>

    </div><!-- /cm-scroll -->

  </div><!-- /cm-panel -->
</div>

<style>
  /* ===========================
     OVERLAY
  =========================== */
  .cm-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    place-items: center;
  }
  .cm-overlay[hidden] { display: none; }

  .cm-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ===========================
     PANEL
  =========================== */
  .cm-panel {
    position: relative;
    z-index: 1;
    width: min(760px, 96vw);
    max-height: 92vh;
    background: var(--cs-card-bg, #faf9f7);
    border: 2px solid var(--cs-border-color, #1d1d1d);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Slide-in animation — triggered by adding .is-open on overlay */
    transform: translateY(24px);
    opacity: 0;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.28s ease;
  }

  .cm-overlay.is-open .cm-panel {
    transform: translateY(0);
    opacity: 1;
  }

  /* ===========================
     PROGRESS BAR
  =========================== */
  .cm-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 10;
  }
  .cm-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--cs-border-color, #1d1d1d);
    transition: width 0.1s linear;
  }

  /* ===========================
     TOP BAR
  =========================== */
  .cm-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 2px solid var(--cs-border-color, #1d1d1d);
    flex-shrink: 0;
    gap: 12px;
  }

  .cm-topbar__nav,
  .cm-topbar__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cm-nav-btn,
  .cm-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    border: 2px solid var(--cs-border-color, #1d1d1d);
    background: transparent;
    font-size: 11px;
    font-family: var(--cs-font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    color: var(--cs-text, #1d1d1d);
  }

  .cm-nav-btn:hover:not(:disabled),
  .cm-action-btn:hover {
    background: var(--cs-border-color, #1d1d1d);
    color: var(--cs-card-bg, #fff);
  }

  .cm-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cm-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--cs-border-color, #1d1d1d);
    background: transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    color: var(--cs-text, #1d1d1d);
    margin-left: 4px;
  }
  .cm-close-btn:hover {
    background: var(--cs-border-color, #1d1d1d);
    color: var(--cs-card-bg, #fff);
  }

  /* ===========================
     SCROLLABLE BODY
  =========================== */
  .cm-scroll {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    scroll-behavior: smooth;
  }

  .cm-scroll::-webkit-scrollbar { width: 6px; }
  .cm-scroll::-webkit-scrollbar-track { background: transparent; }
  .cm-scroll::-webkit-scrollbar-thumb {
    background: var(--cs-border-color, #1d1d1d);
    opacity: 0.3;
  }

  /* ===========================
     HERO IMAGE
  =========================== */
  .cm-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--cs-border-color, #1d1d1d);
  }
  .cm-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===========================
     ARTICLE HEADER
  =========================== */
  .cm-article-header {
    padding: 32px 40px 0;
    border-bottom: 2px solid var(--cs-border-color, #1d1d1d);
    padding-bottom: 24px;
    margin-bottom: 0;
  }

  .cm-title {
    margin: 0 0 16px;
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-family: var(--cs-font-serif, Georgia, serif);
  }

  .cm-meta-slot {
    /* ContentMeta injected here by JS */
  }

  /* ===========================
     PROSE BODY
  =========================== */
  .cm-body {
    padding: 32px 40px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--cs-text, #1d1d1d);
    font-family: var(--cs-font-body, system-ui, sans-serif);
  }

  /* Prose typography */
  .cm-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    margin: 2em 0 0.6em;
    font-family: var(--cs-font-serif, Georgia, serif);
    letter-spacing: -0.01em;
  }
  .cm-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 1.8em 0 0.5em;
  }
  .cm-body :global(p) {
    margin: 0 0 1.4em;
  }
  .cm-body :global(strong) {
    font-weight: 650;
  }
  .cm-body :global(blockquote) {
    margin: 1.6em 0;
    padding: 14px 20px;
    border-left: 4px solid var(--cs-border-color, #1d1d1d);
    font-style: italic;
    opacity: 0.8;
  }
  .cm-body :global(ul), .cm-body :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.4em;
  }
  .cm-body :global(li) {
    margin-bottom: 0.4em;
  }
  .cm-body :global(code) {
    font-family: var(--cs-font-mono, monospace);
    font-size: 0.88em;
    background: rgba(0,0,0,0.06);
    padding: 2px 6px;
  }
  .cm-body :global(pre) {
    background: #1d1d1d;
    color: #faf9f7;
    padding: 20px 24px;
    overflow-x: auto;
    font-family: var(--cs-font-mono, monospace);
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 1.4em;
  }
  .cm-body :global(img) {
    max-width: 100%;
    margin: 1.6em 0;
    border: 2px solid var(--cs-border-color, #1d1d1d);
  }

  /* ===========================
     BOTTOM NAV
  =========================== */
  .cm-bottom-nav {
    display: flex;
    justify-content: space-between;
    padding: 20px 40px 32px;
    border-top: 2px solid var(--cs-border-color, #1d1d1d);
    gap: 16px;
  }

  .cm-bottom-nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 2px solid var(--cs-border-color, #1d1d1d);
    background: transparent;
    font-size: 12px;
    font-family: var(--cs-font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    color: var(--cs-text, #1d1d1d);
    max-width: 45%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cm-bottom-nav__btn--next {
    margin-left: auto;
  }

  .cm-bottom-nav__btn:hover:not(:disabled) {
    background: var(--cs-border-color, #1d1d1d);
    color: var(--cs-card-bg, #fff);
  }

  .cm-bottom-nav__btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  /* ===========================
     RESPONSIVE
  =========================== */
  @media (max-width: 600px) {
    .cm-article-header,
    .cm-body,
    .cm-bottom-nav {
      padding-left: 20px;
      padding-right: 20px;
    }
    .cm-topbar {
      padding: 10px 14px;
    }
    .cm-action-btn span:not(#cm-copy-label) {
      display: none;
    }
  }
</style>
