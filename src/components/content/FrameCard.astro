---
/**
 * FrameCard.astro
 * Reusable illustrated content card.
 * Used by blog.astro, gallery.astro, work.astro, stuff.astro etc.
 * 
 * Swap borderSrc / clipVariant / accentColor per page
 * for a completely different visual identity — zero CSS duplication.
 */

export type ClipVariant = 'octagon' | 'rect' | 'circle' | 'stamp';

export interface Props {
  postId:       string;
  contentType:  string;
  title:        string;
  image:        string;
  views:        number;
  readingTime:  string;
  date:         string;
  description?: string;

  /** Path to the border image PNG (border-image-source) */
  borderSrc?:   string;
  /** border-image-slice values (4 numbers, no 'fill' — added automatically) */
  borderSlice?: string;
  /** border-width shorthand for the card border */
  borderWidth?: string;

  /** Clip shape for the photo zone */
  clipVariant?: ClipVariant;

  /** Path to icon PNGs — all optional, falls back to inline SVG */
  viewsIconSrc?:    string;
  readIconSrc?:     string;
  expandIconSrc?:   string;
  dividerSrc?:      string;

  /** Text / accent color (default salmon) */
  accentColor?: string;
  /** Card background color */
  cardBg?:      string;
}

const {
  postId,
  contentType,
  title,
  image,
  views,
  readingTime,
  date,
  description = '',

  borderSrc   = '/images/frame/blogborder.PNG',
  borderSlice = '16 13 16 13',
  borderWidth = '20px 17px 22px 17px',

  clipVariant = 'octagon',

  viewsIconSrc  = '/images/frame/viewso.PNG',
  readIconSrc   = '/images/frame/readtimeo.PNG',
  expandIconSrc = '/images/frame/maximizeo.PNG',
  dividerSrc    = '/images/frame/cardbreak.PNG',

  accentColor = '#d64e2c',
  cardBg      = '#f5ede0',
} = Astro.props;

/** CSS clip-path values per variant */
const clipPaths: Record<ClipVariant, string> = {
  octagon: 'polygon(10% 0%, 90% 0%, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0% 90%, 0% 10%)',
  rect:    'inset(0)',
  circle:  'circle(50%)',
  stamp:   'polygon(5% 0%, 95% 0%, 100% 5%, 100% 95%, 95% 100%, 5% 100%, 0% 95%, 0% 5%)',
};

const clipPath = clipPaths[clipVariant];

// CSS custom props passed via inline style — avoids generating unique class per instance
const cardStyle = `
  --fc-accent: ${accentColor};
  --fc-bg: ${cardBg};
  --fc-border-src: url('${borderSrc}');
  --fc-border-slice: ${borderSlice};
  --fc-border-width: ${borderWidth};
  --fc-clip: ${clipPath};
  --fc-divider: url('${dividerSrc}');
`.replace(/\s+/g, ' ').trim();
---

<article class="fc" style={cardStyle} data-post-id={postId}>

  <!-- Expand / maximize button — top-right corner of card -->
  <button
    class="fc__expand"
    type="button"
    aria-label={`Read: ${title}`}
    data-expand-post={postId}
    data-content-type={contentType}
  >
    {expandIconSrc
      ? <img src={expandIconSrc} alt="Open" class="fc__expand-img" />
      : <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"/>
          <polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
    }
  </button>

  <!-- Hand-drawn card border -->
  <div class="fc__inner">

    <!-- Photo zone -->
    <div class="fc__img-wrap">
      <img
        src={image}
        alt={title}
        class="fc__img"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Text below photo -->
    <div class="fc__body">
      <h2 class="fc__title">{title}</h2>
      <span class="fc__divider" aria-hidden="true"></span>
      <div class="fc__meta" role="list" aria-label="Post info">

        <!-- Views -->
        <span class="fc__meta-item" role="listitem">
          {viewsIconSrc
            ? <img src={viewsIconSrc} alt="" class="fc__icon" aria-hidden="true" />
            : <svg class="fc__icon" width="12" height="12" viewBox="0 0 24 24"
                   fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
          }
          <span>{views}</span>
        </span>

        <span class="fc__sep" aria-hidden="true">|</span>

        <!-- Reading time -->
        <span class="fc__meta-item" role="listitem">
          {readIconSrc
            ? <img src={readIconSrc} alt="" class="fc__icon" aria-hidden="true" />
            : <svg class="fc__icon" width="12" height="12" viewBox="0 0 24 24"
                   fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
          }
          <span>{readingTime}</span>
        </span>

        <span class="fc__sep" aria-hidden="true">|</span>

        <!-- Date -->
        <time class="fc__date">{date}</time>

      </div>
    </div>

  </div>
</article>

<style>
/* -------------------------------------------------------
   All layout properties reference CSS custom props set
   on the .fc element via inline style — no hardcoded
   values here, making the component infinitely variant.
------------------------------------------------------- */

.fc {
  position: relative;
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  /* Callers control width via the grid (flex-basis) */
}

.fc:hover {
  transform: translateY(-7px);
}

/* Expand button — top-right of card */
.fc__expand {
  position: absolute;
  top: 2px;
  right: 2px;
  z-index: 10;
  width: 28px;
  height: 28px;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
  opacity: 0.85;
  color: var(--fc-accent);
  transition: opacity 0.18s, transform 0.18s;
}

.fc__expand:hover {
  opacity: 1;
  transform: scale(1.2);
}

.fc__expand-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* ---- border frame ---- */
.fc__inner {
  display: flex;
  flex-direction: column;
  background: var(--fc-bg);
  border-style: solid;
  border-color: transparent;
  border-width: var(--fc-border-width);
  border-image-source: var(--fc-border-src);
  border-image-slice: var(--fc-border-slice) fill;
  border-image-repeat: stretch;
}

/* ---- photo zone ---- */
.fc__img-wrap {
  width: 100%;
  aspect-ratio: 3 / 3.4;
  overflow: hidden;
  clip-path: var(--fc-clip);
}

.fc__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.fc:hover .fc__img {
  transform: scale(1.05);
}

/* ---- text body ---- */
.fc__body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 6px 4px;
}

.fc__title {
  font-family: inherit;
  font-size: clamp(11px, 1.7vw, 14px);
  font-weight: 700;
  color: var(--fc-accent);
  line-height: 1.25;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fc__divider {
  display: block;
  width: 100%;
  height: 3px;
  background: var(--fc-divider) center / 100% 100% no-repeat;
  margin: 1px 0;
}

.fc__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 3px 4px;
  font-size: clamp(9px, 1.15vw, 11px);
  color: var(--fc-accent);
  line-height: 1;
}

.fc__meta-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.fc__icon {
  width: 12px;
  height: 12px;
  object-fit: contain;
  flex-shrink: 0;
  display: block;
}

.fc__sep {
  opacity: 0.45;
  font-size: 10px;
}

.fc__date {
  white-space: nowrap;
  font-size: clamp(9px, 1.1vw, 11px);
  color: var(--fc-accent);
  opacity: 0.9;
}
</style>
