---
import MusicModal from './MusicModal.astro';
import PersonalModal from './PersonalModal.astro';
import PoetryModal from './PoetryModal.astro';
import TodoModal from './TodoModal.astro';
import PhotoWallModal from './PhotoWallModal.astro';
import DailyDoseModal from './DailyDoseModal.astro';
---

<div id="modal-overlay" class="modal-overlay" hidden>
	<div class="modal" role="dialog" aria-modal="true">
		<button class="modal-close" type="button" aria-label="Close">&times;</button>

		<div class="modal-panel" data-modal-key="music" hidden>
			<MusicModal />
		</div>
		<div class="modal-panel" data-modal-key="personal" hidden>
			<PersonalModal />
		</div>
		<div class="modal-panel" data-modal-key="poetry" hidden>
			<PoetryModal />
		</div>
		<div class="modal-panel" data-modal-key="todo" hidden>
			<TodoModal />
		</div>
		<div class="modal-panel" data-modal-key="photowall" hidden>
			<PhotoWallModal />
		</div>
		<div class="modal-panel" data-modal-key="dailydose" hidden>
			<DailyDoseModal />
		</div>
	</div>
</div>

<style>
	.modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		display: grid;
		place-items: center;
		z-index: 1000;
	}
	.modal-overlay[hidden] { display: none; }

	.modal {
		position: relative;
		background: #fff;
		color: #111;
		width: min(90vw, 560px);
		max-height: 85vh;
		overflow-y: auto;
		border-radius: 12px;
		padding: 32px;
	}

	.modal-close {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 32px;
		height: 32px;
		border: 0;
		background: transparent;
		font-size: 24px;
		cursor: pointer;
	}
</style>